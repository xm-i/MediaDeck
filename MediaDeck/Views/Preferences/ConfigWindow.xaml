<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="MediaDeck.Views.Preferences.ConfigWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:config="using:MediaDeck.ViewModels.Preferences.Config"
	xmlns:controls="using:MediaDeck.Views.Controls"
	mc:Ignorable="d"
	Title="設定" >
	<Window.SystemBackdrop>
		<DesktopAcrylicBackdrop/>
	</Window.SystemBackdrop>
	<Grid Background="Transparent"
		Loaded="Window_Loaded" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- カスタムタイトルバー -->
		<controls:WindowTitleBar x:Name="AppTitleBar" Grid.Row="0" Title="{x:Bind Title}" />

		<NavigationView x:Name="SettingsNavView"
			Grid.Row="1"
			IsBackButtonVisible="Collapsed"
			IsSettingsVisible="False"
			AlwaysShowHeader="False"
			PaneDisplayMode="Left"
			OpenPaneLength="280"
			MenuItemsSource="{x:Bind ViewModel.ConfigPageViewModels}"
			SelectedItem="{x:Bind ViewModel.SelectedPageViewModel.Value, Mode=TwoWay}" >

			<!-- ナビゲーションメニュー項目のテンプレート -->
			<NavigationView.MenuItemTemplate>
				<DataTemplate x:DataType="config:IConfigPageViewModel" >
					<NavigationViewItem>
						<NavigationViewItem.Icon>
							<FontIcon Glyph="{Binding PageIconGlyph}" />
						</NavigationViewItem.Icon>
						<NavigationViewItem.Content>
							<StackPanel Spacing="2" >
								<TextBlock Text="{Binding PageName}"
									FontSize="14"
									FontWeight="SemiBold" />
								<TextBlock Text="{Binding PageDescription}"
									FontSize="11"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									TextTrimming="CharacterEllipsis" />
							</StackPanel>
						</NavigationViewItem.Content>
					</NavigationViewItem>
				</DataTemplate>
			</NavigationView.MenuItemTemplate>

			<!-- コンテンツ領域 -->
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<!-- ページコンテンツ表示用の Frame -->
				<Frame x:Name="ContentFrame"
					Grid.Row="0" />

				<!-- フッター: 保存ボタン -->
				<Border Grid.Row="1"
					Padding="24,12"
					BorderThickness="0,1,0,0"
					BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" >
					<StackPanel Orientation="Horizontal"
						HorizontalAlignment="Right"
						Spacing="12" >
						<Button Command="{x:Bind ViewModel.ApplyCommand}"
							MinWidth="120" >
							<StackPanel Orientation="Horizontal"
								Spacing="8" >
								<FontIcon Glyph="&#xE73E;"
									FontSize="14" />
								<TextBlock x:Uid="ConfigWindow_Apply" />
							</StackPanel>
						</Button>
						<Button Style="{StaticResource AccentButtonStyle}"
							Command="{x:Bind ViewModel.SaveCommand}"
							MinWidth="120" >
							<StackPanel Orientation="Horizontal"
								Spacing="8" >
								<FontIcon Glyph="&#xE74E;"
									FontSize="14" />
								<TextBlock x:Uid="ConfigWindow_Save" />
							</StackPanel>
						</Button>
					</StackPanel>
				</Border>
			</Grid>
		</NavigationView>
	</Grid>
</Window>
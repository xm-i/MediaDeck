<local:EnvironmentConfigPageBase x:Class="MediaDeck.Views.Preferences.Config.EnvironmentConfigPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:MediaDeck.Views.Preferences.Config"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:viewModels="using:MediaDeck.ViewModels.Preferences.Config"
  x:DataType="viewModels:EnvironmentConfigPageViewModel"
  mc:Ignorable="d"
  Background="Transparent">
  <Grid MaxWidth="800" Margin="36,24,36,36">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="4">
	  <StackPanel Spacing="4" Margin="0,0,0,16">
		<TextBlock x:Uid="EnvironmentConfigPage_SectionHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
		<TextBlock x:Uid="EnvironmentConfigPage_SectionDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
	  </StackPanel>
	  <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12">
		<Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="12">
		  <TextBlock x:Uid="EnvironmentConfigPage_ThemeLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" Style="{StaticResource BodyTextBlockStyle}" />
		  <ComboBox Grid.Row="0"
					Grid.Column="1"
					HorizontalAlignment="Left"
					MinWidth="200"
					ItemsSource="{x:Bind ViewModel.ThemeOptions}"
					SelectedItem="{x:Bind ViewModel.SelectedTheme.Value, Mode=TwoWay}" />

		  <TextBlock x:Uid="EnvironmentConfigPage_SystemBackdropLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" Style="{StaticResource BodyTextBlockStyle}" />
		  <ComboBox Grid.Row="1"
					Grid.Column="1"
					HorizontalAlignment="Left"
					MinWidth="200"
					ItemsSource="{x:Bind ViewModel.SystemBackdropOptions}"
					SelectedItem="{x:Bind ViewModel.SelectedSystemBackdrop.Value, Mode=TwoWay}" />

		  <TextBlock x:Uid="EnvironmentConfigPage_AppDataDirectoryLabel" Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="0,8,16,0" Style="{StaticResource BodyTextBlockStyle}" />
		  <StackPanel Grid.Row="2" Grid.Column="1" Spacing="8">
			<TextBlock Text="{x:Bind ViewModel.AppDataDirectoryPath, Mode=OneWay}" TextWrapping="WrapWholeWords" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
			<Button Command="{x:Bind ViewModel.OpenAppDataDirectoryCommand}" HorizontalAlignment="Left">
			  <StackPanel Orientation="Horizontal" Spacing="8">
				<FontIcon Glyph="&#xE838;" FontSize="14" />
				<TextBlock x:Uid="EnvironmentConfigPage_OpenAppDataDirectory" FontWeight="SemiBold" />
			  </StackPanel>
			</Button>
		  </StackPanel>
		</Grid>
	  </Border>
	  <InfoBar x:Uid="EnvironmentConfigPage_RestartNotice" IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,16,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</local:EnvironmentConfigPageBase>

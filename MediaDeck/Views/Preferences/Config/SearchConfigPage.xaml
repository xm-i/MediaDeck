<local:SearchConfigPageBase x:Class="MediaDeck.Views.Preferences.Config.SearchConfigPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Preferences.Config"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	Background="Transparent"
	x:Name="PageRoot" >

	<Grid MaxWidth="800" Margin="36,24,36,36">
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel Spacing="4">

			<StackPanel Spacing="4" Margin="0,0,0,16" >
				<TextBlock x:Uid="SearchConfigPage_CountSettingsHeader"
					Style="{StaticResource BodyStrongTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
				<TextBlock x:Uid="SearchConfigPage_CountSettingsDescription"
					Style="{StaticResource CaptionTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
			</StackPanel>

			<!-- 初期ロード件数 -->
			<StackPanel Spacing="8" Margin="0,0,0,16">
				<TextBlock x:Uid="SearchConfigPage_InitialLoadCount" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
				<TextBlock x:Uid="SearchConfigPage_InitialLoadCountDesc" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				<NumberBox Value="{x:Bind ViewModel.InitialLoadCount.Value, Mode=TwoWay}" Minimum="1" Maximum="100000" SpinButtonPlacementMode="Compact" HorizontalAlignment="Left" Width="200" />
			</StackPanel>

			<!-- 増分読み込み件数 -->
			<StackPanel Spacing="8" Margin="0,0,0,16">
				<TextBlock x:Uid="SearchConfigPage_IncrementalLoadCount" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
				<TextBlock x:Uid="SearchConfigPage_IncrementalLoadCountDesc" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				<NumberBox Value="{x:Bind ViewModel.IncrementalLoadCount.Value, Mode=TwoWay}" Minimum="1" Maximum="100000" SpinButtonPlacementMode="Compact" HorizontalAlignment="Left" Width="200" />
			</StackPanel>

			<!-- 最大ロード件数 -->
			<StackPanel Spacing="8" Margin="0,0,0,16">
				<TextBlock x:Uid="SearchConfigPage_MaxLoadCount" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
				<TextBlock x:Uid="SearchConfigPage_MaxLoadCountDesc" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				<NumberBox Value="{x:Bind ViewModel.MaxLoadCount.Value, Mode=TwoWay}" Minimum="1" Maximum="500000" SpinButtonPlacementMode="Compact" HorizontalAlignment="Left" Width="200" />
			</StackPanel>

			</StackPanel>
		</ScrollViewer>
	</Grid>
</local:SearchConfigPageBase>

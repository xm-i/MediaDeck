<Page x:Class="MediaDeck.Views.Preferences.Config.ExecutionConfigPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:config="using:MediaDeck.Composition.Interfaces.MediaItemTypes.ViewModels"
	mc:Ignorable="d"
	Background="Transparent"
	x:Name="PageRoot" >

	<Grid MaxWidth="800" Margin="36,24,36,36">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
			<StackPanel Spacing="4">
				<!-- セクションヘッダー -->
				<StackPanel Spacing="4"
					Margin="0,0,0,16" >
					<TextBlock x:Uid="Execution_Header"
						Style="{StaticResource BodyStrongTextBlockStyle}"
						Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
					<TextBlock x:Uid="Execution_Description"
						Style="{StaticResource CaptionTextBlockStyle}"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				</StackPanel>

				<!-- 起動引数の説明ヘルプ -->
				<Expander x:Uid="Execution_Help_Expander"
					HorizontalAlignment="Stretch"
					Margin="0,0,0,16" >
					<StackPanel Spacing="8" Padding="16">
						<TextBlock x:Uid="Execution_Help_Intro"
							TextWrapping="Wrap" />
						<Grid Margin="0,8,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<!-- {path} -->
							<TextBlock Grid.Row="0" Grid.Column="0"
								Text="{}{path}"
								FontWeight="SemiBold"
								Margin="0,0,16,4"/>
							<TextBlock Grid.Row="0" Grid.Column="1"
								x:Uid="Execution_Help_Path"
								TextWrapping="Wrap"
								Margin="0,0,0,4"/>
							
							<!-- {dir} -->
							<TextBlock Grid.Row="1" Grid.Column="0"
								Text="{}{dir}"
								FontWeight="SemiBold"
								Margin="0,0,16,4"/>
							<TextBlock Grid.Row="1" Grid.Column="1"
								x:Uid="Execution_Help_Dir"
								TextWrapping="Wrap"
								Margin="0,0,0,4"/>
							
							<!-- {name} -->
							<TextBlock Grid.Row="2" Grid.Column="0"
								Text="{}{name}"
								FontWeight="SemiBold"
								Margin="0,0,16,4"/>
							<TextBlock Grid.Row="2" Grid.Column="1"
								x:Uid="Execution_Help_Name"
								TextWrapping="Wrap"
								Margin="0,0,0,4"/>
							
							<!-- {namenoext} -->
							<TextBlock Grid.Row="3" Grid.Column="0"
								Text="{}{namenoext}"
								FontWeight="SemiBold"
								Margin="0,0,16,4"/>
							<TextBlock Grid.Row="3" Grid.Column="1"
								x:Uid="Execution_Help_NameNoExt"
								TextWrapping="Wrap"
								Margin="0,0,0,4"/>
							
							<!-- {ext} -->
							<TextBlock Grid.Row="4" Grid.Column="0"
								Text="{}{ext}"
								FontWeight="SemiBold"
								Margin="0,0,16,4"/>
							<TextBlock Grid.Row="4" Grid.Column="1"
								x:Uid="Execution_Help_Ext"
								TextWrapping="Wrap"
								Margin="0,0,0,4"/>
						</Grid>
						<TextBlock x:Uid="Execution_Help_Note"
							Margin="0,8,0,0"
							Style="{StaticResource CaptionTextBlockStyle}"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
					</StackPanel>
				</Expander>

				<!-- プログラムリスト -->
				<ItemsControl ItemsSource="{x:Bind ViewModel.ExecutionPrograms}" >
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="config:IExecutionProgramConfigViewModel" >
							<Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
								BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
								BorderThickness="1"
								CornerRadius="4"
								Padding="16,12"
								Margin="0,0,0,2" >
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<!-- 上段: メディアタイプ選択 -->
									<StackPanel Grid.Row="0"
										Grid.Column="0"
										Orientation="Horizontal"
										Spacing="12"
										VerticalAlignment="Center" >
										<FontIcon Glyph="&#xE756;"
											FontSize="16"
											Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
											VerticalAlignment="Center" />
										<TextBlock Text="{x:Bind MediaType}" />
									</StackPanel>

									<!-- 削除ボタン -->
									<Button Grid.Row="0"
										Grid.Column="1"
										VerticalAlignment="Center"
										Command="{x:Bind RemoveCommand}"
										Style="{StaticResource SubtleButtonStyle}"
										x:Uid="Execution_RemoveProgram"
										Padding="6"
										BorderThickness="0" >
										<FontIcon Glyph="&#xE74D;"
											FontSize="14"
											Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
									</Button>

									<!-- 下段: 動的な設定UI -->
									<ContentControl Grid.Row="1"
										Grid.Column="0"
										Grid.ColumnSpan="2"
										Content="{x:Bind}"
										ContentTemplateSelector="{StaticResource MediaItemExecutionConfigTplSel}" />
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>

		<!-- 追加セクション -->
		<Grid Grid.Row="1"
			Margin="0,8,0,0"
			ColumnSpacing="8"
			VerticalAlignment="Bottom" >
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<ComboBox Grid.Column="0"
				HorizontalAlignment="Stretch"
				x:Uid="Execution_AddMediaTypeHeader"
				ItemsSource="{x:Bind ViewModel.AvailableMediaTypes}"
				SelectedItem="{x:Bind ViewModel.SelectedMediaType.Value, Mode=TwoWay}" />
			<Button Grid.Column="1"
				VerticalAlignment="Bottom"
				Command="{x:Bind ViewModel.AddExecutionProgramCommand}">
				<StackPanel Orientation="Horizontal"
					Spacing="8" >
					<FontIcon Glyph="&#xE710;"
						FontSize="14" />
					<TextBlock x:Uid="Execution_AddProgramButton"
						FontWeight="SemiBold" />
				</StackPanel>
			</Button>
		</Grid>
	</Grid>
</Page>
<local:LanguageConfigPageBase x:Class="MediaDeck.Views.Preferences.Config.LanguageConfigPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:MediaDeck.Views.Preferences.Config"
  xmlns:viewModels="using:MediaDeck.ViewModels.Preferences.Config"
  x:DataType="viewModels:LanguageConfigPageViewModel"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Background="Transparent">
  <Grid MaxWidth="800" Margin="36,24,36,36">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="4">
      <StackPanel Spacing="4" Margin="0,0,0,16">
        <TextBlock x:Uid="LanguageConfigPage_SectionHeader" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        <TextBlock x:Uid="LanguageConfigPage_SectionDescription" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock x:Uid="LanguageConfigPage_LanguageLabel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" Style="{StaticResource BodyTextBlockStyle}" />
          <ComboBox x:Name="LanguageComboBox"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    MinWidth="200"
                    ItemsSource="{x:Bind ViewModel.LanguageOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedLanguage.Value, Mode=TwoWay}"
                    DisplayMemberPath="DisplayName" />
        </Grid>
      </Border>
      <InfoBar x:Uid="LanguageConfigPage_RestartNotice" IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,16,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</local:LanguageConfigPageBase>

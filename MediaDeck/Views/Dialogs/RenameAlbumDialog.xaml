<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
	x:Class="MediaDeck.Views.Dialogs.RenameAlbumDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	mc:Ignorable="d"
	x:Uid="RenameAlbumDialog"
	MinWidth="340"
	DefaultButton="Primary"
	PrimaryButtonClick="ContentDialog_PrimaryButtonClick" >
	<StackPanel Spacing="8" >
		<TextBlock x:Uid="RenameAlbumDialog_NameLabel" />
		<TextBox x:Name="AlbumNameTextBox"
			Text="{x:Bind AlbumName.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			x:Uid="RenameAlbumDialog_NamePlaceholder"
			Loaded="AlbumNameTextBox_Loaded" />
		<TextBlock x:Uid="RenameAlbumDialog_PathLabel" />
		<TextBox Text="{x:Bind AlbumPath.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			x:Uid="RenameAlbumDialog_PathPlaceholder" />
		<TextBlock Text="{x:Bind ErrorMessage.Value, Mode=OneWay}"
			Foreground="{ThemeResource SystemFillColorCriticalBrush}"
			TextWrapping="Wrap"
			Visibility="{x:Bind ErrorMessage.Value, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
	</StackPanel>
</ContentDialog>

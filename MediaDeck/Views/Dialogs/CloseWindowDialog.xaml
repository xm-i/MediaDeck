<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
	x:Class="MediaDeck.Views.Dialogs.CloseWindowDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	x:Uid="CloseWindowDialog"
	DefaultButton="Primary">

	<StackPanel Margin="0,8" Spacing="16" MinWidth="380">
		<TextBlock x:Name="MessageTextBlock"
				   TextWrapping="WrapWholeWords" />

		<StackPanel x:Name="TargetWindowPanel"
					Spacing="6"
					Visibility="Collapsed">
			<TextBlock x:Uid="CloseWindowDialog_TargetWindowHeader" />
			<ComboBox x:Name="TargetWindowComboBox"
					  HorizontalAlignment="Stretch"
					  DisplayMemberPath="DisplayName"
					  SelectedValuePath="WindowId" />
		</StackPanel>
	</StackPanel>
</ContentDialog>

<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="MediaDeck.Views.Thumbnails.ThumbnailPickerWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:controls="using:MediaDeck.Views.Controls"
	mc:Ignorable="d"
	Title="Thumbnail Picker" >
	<Window.SystemBackdrop>
		<DesktopAcrylicBackdrop/>
	</Window.SystemBackdrop>
	<Grid Background="Transparent"
		Loaded="Window_Loaded" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- カスタムタイトルバー -->
		<controls:WindowTitleBar x:Name="AppTitleBar" Grid.Row="0" Title="{x:Bind Title}" />

		<ContentControl Grid.Row="1" Content="{x:Bind ViewModel.ThumbnailPickerViewModel.Value, Mode=OneWay}"
			ContentTemplateSelector="{StaticResource MediaItemThumbnailPickerTplSel}"
			HorizontalContentAlignment="Stretch"
			VerticalContentAlignment="Stretch" />
	</Grid>
</Window>
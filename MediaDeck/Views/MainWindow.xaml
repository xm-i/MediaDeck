<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="MediaDeck.Views.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views"
	xmlns:localControls="using:MediaDeck.Views.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:viewerPanes="using:MediaDeck.Views.Panes.ViewerPanes"
	xmlns:filterPanes="using:MediaDeck.Views.Panes.FilterPanes"
	xmlns:sortPanes="using:MediaDeck.Views.Panes.SortPanes"
	xmlns:detailPanes="using:MediaDeck.Views.Panes.DetailPanes"
	xmlns:repositoryPanes="using:MediaDeck.Views.Panes.RepositoryPanes"
	xmlns:viewmodels="using:MediaDeck.ViewModels"
	xmlns:statusPanes="using:MediaDeck.Views.Panes.StatusPanes"
	xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
	mc:Ignorable="d"
	Title="MediaDeck" >
	<Window.SystemBackdrop>
		<DesktopAcrylicBackdrop/>
	</Window.SystemBackdrop>
	<Grid Loaded="Window_Loaded"
		Background="Transparent" >
		<Grid.RowDefinitions>
			<RowDefinition Height="48" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- カスタムタイトルバー -->
		<Grid x:Name="AppTitleBar" Grid.Row="0"
			Background="{ThemeResource TitleBarBackgroundBrush}"
			Padding="0,0,188,0"
			VerticalAlignment="Stretch" >
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
				<Image Source="/Assets/Square44x44Logo.scale-200.png"
					Width="16" Height="16"
					Margin="16,0,8,0" />
			</StackPanel>

			<!-- ナビゲーションメニュー（全タブ共通） -->
			<local:NavigationMenu Grid.Column="1"
				x:Name="NavigationMenuControl"
				Margin="12,0,0,0"
				HorizontalAlignment="Left"
				VerticalAlignment="Center"
				ViewModel="{x:Bind _viewModel.NavigationMenuViewModel}"/>
		</Grid>

		<!-- TabView -->
		<TabView Grid.Row="1"
			x:Name="MainTabView"
			VerticalAlignment="Stretch"
			IsAddTabButtonVisible="True"
			AddTabButtonCommand="{x:Bind _viewModel.AddTabCommand}"
			TabCloseRequested="MainTabView_TabCloseRequested"
			SelectionChanged="MainTabView_SelectionChanged"
			TabWidthMode="SizeToContent"
			TabItemsSource="{x:Bind _viewModel.Tabs}"
			Style="{StaticResource ModernTabViewStyle}">
			<TabView.TabItemTemplate>
					<DataTemplate x:DataType="viewmodels:TabViewModel">
						<TabViewItem KeyDown="TabViewItem_KeyDown" Style="{StaticResource ModernTabViewItemStyle}">
							<TabViewItem.ContextFlyout>
								<MenuFlyout Opening="TabContextFlyout_Opening">
									<MenuFlyoutItem x:Name="RenameTabItem" Click="RenameTab_Click" />
									<MenuFlyoutSeparator />
									<MenuFlyoutItem x:Name="OpenInNewWindowItem" Click="OpenInNewWindow_Click" />
									<MenuFlyoutSubItem x:Name="MoveToWindowSubItem" />
								</MenuFlyout>
							</TabViewItem.ContextFlyout>
						<TabViewItem.Header>
							<Grid Background="Transparent" DoubleTapped="TabHeader_DoubleTapped">
								<TextBlock Text="{x:Bind DisplayName.Value, Mode=OneWay}" />
							</Grid>
						</TabViewItem.Header>
						<Grid x:Name="TabContentGrid"
							Padding="2"
							Tag="{x:Bind}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="{Binding ElementName=TabContentGrid, Path=Tag.LeftPaneWidth.Value, Mode=TwoWay, Converter={StaticResource DoubleToGridLengthConverter}}" MinWidth="100" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="{Binding ElementName=TabContentGrid, Path=Tag.RightPaneWidth.Value, Mode=TwoWay, Converter={StaticResource DoubleToGridLengthConverter}}" MinWidth="100" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="{Binding ElementName=TabContentGrid, Path=Tag.RepositoryPaneHeight.Value, Mode=TwoWay, Converter={StaticResource DoubleToGridLengthConverter}}" MinHeight="100" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>
							<repositoryPanes:RepositorySelector Grid.Column="0" Grid.Row="0"
								ViewModel="{x:Bind RepositorySelectorViewModel, Mode=OneWay}" />
							<toolkit:GridSplitter Grid.Column="0" Grid.Row="1"
								Height="4"
								ResizeDirection="Rows"
								ResizeBehavior="BasedOnAlignment"
								HorizontalAlignment="Stretch" />
							<Grid Grid.Column="0" Grid.Row="2">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
								</Grid.RowDefinitions>
								<sortPanes:SortPane Grid.Row="0"
									ViewModel="{x:Bind SortSelectorViewModel, Mode=OneWay}" />
								<filterPanes:FilterSelector Grid.Row="1"
									ViewModel="{x:Bind FilterSelectorViewModel, Mode=OneWay}" />
							</Grid>
							<toolkit:GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
								Width="4"
								ResizeBehavior="BasedOnAlignment" />
							<viewerPanes:ViewerSelector Grid.Column="2" Grid.Row="0" Grid.RowSpan="3"
								ViewModel="{x:Bind ViewerSelectorViewModel, Mode=OneWay}" />
							<toolkit:GridSplitter Grid.Column="3" Grid.Row="0" Grid.RowSpan="3"
								Width="4"
								ResizeBehavior="BasedOnAlignment" />
							<detailPanes:DetailSelector Grid.Column="4" Grid.Row="0" Grid.RowSpan="3"
								ViewModel="{x:Bind DetailSelectorViewModel, Mode=OneWay}" />
						</Grid>
					</TabViewItem>
				</DataTemplate>
			</TabView.TabItemTemplate>
			<TabView.TabStripFooter>
				<localControls:GlobalInfoBar
					ViewModel="{x:Bind _viewModel.GlobalInfoBarViewModel, Mode=OneWay}"
					VerticalAlignment="Center"
					HorizontalAlignment="Right"
					Margin="0,0,8,0" />
			</TabView.TabStripFooter>
		</TabView>

		<!-- ステータスバー -->
		<statusPanes:StatusBarPane Grid.Row="2"
			ViewModel="{x:Bind _viewModel.SelectedTab.Value.StatusBarViewModel, Mode=OneWay}" />

		<!-- ウィンドウのボーダー (活性状態に応じて色が変わる) -->
		<Border x:Name="RootBorder"
				Grid.RowSpan="3"
				BorderThickness="1"
				BorderBrush="Gray"
				IsHitTestVisible="False" />
	</Grid>
</Window>
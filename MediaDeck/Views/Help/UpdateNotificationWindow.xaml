<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="MediaDeck.Views.Help.UpdateNotificationWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:MediaDeck.Views.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" >
	<Window.SystemBackdrop>
		<MicaBackdrop Kind="BaseAlt"/>
	</Window.SystemBackdrop>

	<Grid Background="Transparent" Loaded="Window_Loaded" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- カスタムタイトルバー -->
		<controls:WindowTitleBar x:Name="AppTitleBar" Grid.Row="0" Title="{x:Bind Title}" />

		<!-- メインコンテンツ -->
		<Grid Grid.Row="1" Padding="24,16,24,20" RowSpacing="16" >
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<!-- ヘッダー情報 -->
			<Border Grid.Row="0"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="6"
				Padding="16" >
				<Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" >
					<Border Grid.Column="0"
						Width="44"
						Height="44"
						CornerRadius="8"
						Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
						BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
						BorderThickness="1"
						VerticalAlignment="Center" >
						<FontIcon FontFamily="Segoe Fluent Icons"
							Glyph="&#xE896;"
							FontSize="20"
							Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
					</Border>
					<StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" >
						<TextBlock x:Uid="UpdateNotification_Heading"
							Style="{StaticResource BodyStrongTextBlockStyle}"
							TextWrapping="Wrap" />
						<TextBlock Text="{x:Bind ViewModel.VersionTransitionText.Value, Mode=OneWay}"
							FontSize="13"
							FontWeight="SemiBold"
							Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
						<TextBlock Text="{x:Bind ViewModel.PublishedAtText.Value, Mode=OneWay}"
							Style="{StaticResource CaptionTextBlockStyle}"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Visibility="{x:Bind ViewModel.HasPublishedAt.Value, Mode=OneWay}" />
					</StackPanel>
				</Grid>
			</Border>

			<!-- リリースノート -->
			<Grid Grid.Row="1" RowSpacing="8" >
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0" Spacing="2" >
					<TextBlock x:Uid="UpdateNotification_ReleaseNotesLabel"
						Style="{StaticResource BodyStrongTextBlockStyle}" />
					<TextBlock Text="{x:Bind ViewModel.ReleaseName.Value, Mode=OneWay}"
						Style="{StaticResource CaptionTextBlockStyle}"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Visibility="{x:Bind ViewModel.HasReleaseName.Value, Mode=OneWay}" />
				</StackPanel>

				<Border Grid.Row="1"
					Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
					BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
					BorderThickness="1"
					CornerRadius="6" >
					<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" >
						<TextBlock Text="{x:Bind ViewModel.ReleaseNotes.Value, Mode=OneWay}"
							TextWrapping="Wrap"
							IsTextSelectionEnabled="True"
							LineHeight="20" />
					</ScrollViewer>
				</Border>
			</Grid>
		</Grid>

		<!-- フッター -->
		<Border Grid.Row="2"
			Padding="24,12"
			BorderThickness="0,1,0,0"
			BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" >
			<StackPanel Orientation="Horizontal"
				HorizontalAlignment="Right"
				Spacing="12" >
				<Button x:Uid="UpdateNotification_CloseButton"
					Command="{x:Bind ViewModel.CloseCommand}"
					MinWidth="110" />
				<Button Style="{StaticResource AccentButtonStyle}"
					Command="{x:Bind ViewModel.OpenReleasePageCommand}"
					MinWidth="180" >
					<StackPanel Orientation="Horizontal" Spacing="8" >
						<FontIcon Glyph="&#xE8A7;" FontSize="14" />
						<TextBlock x:Uid="UpdateNotification_OpenDownloadPageButton" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Border>
	</Grid>
</Window>

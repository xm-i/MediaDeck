<Window x:Class="MediaDeck.Views.Help.LicenseWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Help"
	xmlns:vm="using:MediaDeck.ViewModels.Help"
	xmlns:controls="using:MediaDeck.Views.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" >
	<Window.SystemBackdrop>
		<MicaBackdrop Kind="BaseAlt"/>
	</Window.SystemBackdrop>

	<Grid Background="Transparent" Loaded="Window_Loaded" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- カスタムタイトルバー -->
		<controls:WindowTitleBar x:Name="AppTitleBar" Grid.Row="0" Title="{x:Bind Title}" />

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="250" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!-- ライブラリ一覧 (Master) -->
			<ListView Grid.Column="0"
				ItemsSource="{x:Bind ViewModel.Licenses}"
				SelectedItem="{x:Bind ViewModel.SelectedLicense.Value, Mode=TwoWay}"
				Padding="0"
				BorderThickness="0,0,1,0"
				BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="vm:LicenseInfo">
						<StackPanel Padding="12,8">
							<TextBlock Text="{x:Bind LibraryName}" FontSize="14" FontWeight="SemiBold"/>
							<TextBlock Text="{x:Bind LicenseName}" FontSize="12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
						</StackPanel>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<!-- 詳細表示 (Detail) -->
			<Grid Grid.Column="1" Padding="24" Background="{ThemeResource LayerFillColorDefaultBrush}">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="12" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0" Spacing="4">
					<TextBlock Text="{x:Bind ViewModel.SelectedLicense.Value.LibraryName, Mode=OneWay}" FontSize="24" FontWeight="Bold"/>
					<TextBlock Text="{x:Bind ViewModel.SelectedLicense.Value.LicenseName, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
					<HyperlinkButton Content="{x:Bind ViewModel.SelectedLicense.Value.Url, Mode=OneWay}" NavigateUri="{x:Bind ViewModel.SelectedLicense.Value.Url, Mode=OneWay}" Padding="0" FontSize="12"/>
				</StackPanel>

				<ScrollViewer Grid.Row="2" Padding="12" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" CornerRadius="4">
					<TextBlock Text="{x:Bind ViewModel.SelectedLicense.Value.LicenseText, Mode=OneWay}"
						TextWrapping="Wrap"
						FontFamily="Consolas, 'Courier New', monospace"
						FontSize="13"/>
				</ScrollViewer>
			</Grid>
		</Grid>
	</Grid>
</Window>

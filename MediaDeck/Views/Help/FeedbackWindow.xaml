<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="MediaDeck.Views.Help.FeedbackWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Help"
	xmlns:controls="using:MediaDeck.Views.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" >
	<Window.SystemBackdrop>
		<MicaBackdrop Kind="BaseAlt"/>
	</Window.SystemBackdrop>

	<Grid Background="Transparent" Loaded="Window_Loaded" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- カスタムタイトルバー -->
		<controls:WindowTitleBar x:Name="AppTitleBar" Grid.Row="0" Title="{x:Bind Title}" />

		<!-- メインフォーム領域 -->
		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" >
			<StackPanel Padding="24,16,24,24" Spacing="16" >
				<TextBlock x:Uid="Feedback_HeaderDescription"
					TextWrapping="Wrap"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

				<InfoBar x:Uid="Feedback_ErrorInfoBar"
					Severity="Error"
					IsClosable="False"
					IsOpen="{x:Bind ViewModel.HasError.Value, Mode=OneWay}"
					Message="{x:Bind ViewModel.ErrorMessage.Value, Mode=OneWay}" />

				<ComboBox x:Uid="Feedback_CategoryComboBox"
					HorizontalAlignment="Stretch"
					ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
					SelectedItem="{x:Bind ViewModel.SelectedCategory.Value, Mode=TwoWay}"
					ItemTemplate="{StaticResource DisplayObjectComboBoxItemTemplate}" />

				<TextBox x:Uid="Feedback_TitleTextBox"
					Text="{x:Bind ViewModel.Title.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

				<TextBox x:Uid="Feedback_DescriptionTextBox"
					AcceptsReturn="True"
					TextWrapping="Wrap"
					MinHeight="140"
					MaxHeight="240"
					ScrollViewer.VerticalScrollBarVisibility="Auto"
					Text="{x:Bind ViewModel.Description.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

				<TextBox x:Uid="Feedback_ContactTextBox"
					Text="{x:Bind ViewModel.Contact.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

				<!-- スクリーンショット添付 -->
				<StackPanel Spacing="8" >
					<TextBlock x:Uid="Feedback_ScreenshotLabel"
						Style="{StaticResource BodyStrongTextBlockStyle}" />
					<StackPanel Orientation="Horizontal" Spacing="8" >
						<Button Command="{x:Bind ViewModel.PickScreenshotCommand}" >
							<StackPanel Orientation="Horizontal" Spacing="8" >
								<FontIcon Glyph="&#xEB9F;" FontSize="14" />
								<TextBlock x:Uid="Feedback_PickScreenshotButton" />
							</StackPanel>
						</Button>
						<Button Command="{x:Bind ViewModel.ClearScreenshotCommand}"
							Visibility="{x:Bind ViewModel.HasScreenshot.Value, Mode=OneWay}" >
							<StackPanel Orientation="Horizontal" Spacing="8" >
								<FontIcon Glyph="&#xE74D;" FontSize="14" />
								<TextBlock x:Uid="Feedback_ClearScreenshotButton" />
							</StackPanel>
						</Button>
					</StackPanel>
					<Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
						BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
						BorderThickness="1"
						CornerRadius="4"
						Padding="8"
						HorizontalAlignment="Left"
						Visibility="{x:Bind ViewModel.HasScreenshot.Value, Mode=OneWay}" >
						<Image Source="{x:Bind ConvertScreenshot(ViewModel.ScreenshotBytes.Value), Mode=OneWay}"
							MaxHeight="200"
							Stretch="Uniform" />
					</Border>
				</StackPanel>

				<!-- 環境情報 -->
				<Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" >
					<Expander.Header>
						<CheckBox x:Uid="Feedback_IncludeEnvironmentCheckBox"
							IsChecked="{x:Bind ViewModel.IncludeEnvironmentInfo.Value, Mode=TwoWay}" />
					</Expander.Header>
					<TextBox IsReadOnly="True"
						AcceptsReturn="True"
						TextWrapping="Wrap"
						FontFamily="Consolas, 'Courier New', monospace"
						FontSize="12"
						MaxHeight="180"
						ScrollViewer.VerticalScrollBarVisibility="Auto"
						Text="{x:Bind ViewModel.EnvironmentInfo, Mode=OneWay}" />
				</Expander>

				<!-- 直近のログ -->
				<Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" >
					<Expander.Header>
						<CheckBox x:Uid="Feedback_IncludeLogsCheckBox"
							IsChecked="{x:Bind ViewModel.IncludeLogs.Value, Mode=TwoWay}" />
					</Expander.Header>
					<StackPanel Spacing="8" >
						<Button Command="{x:Bind ViewModel.RefreshLogsCommand}"
							HorizontalAlignment="Right" >
							<StackPanel Orientation="Horizontal" Spacing="8" >
								<FontIcon Glyph="&#xE72C;" FontSize="14" />
								<TextBlock x:Uid="Feedback_RefreshLogsButton" />
							</StackPanel>
						</Button>
						<TextBox IsReadOnly="True"
							AcceptsReturn="True"
							TextWrapping="NoWrap"
							FontFamily="Consolas, 'Courier New', monospace"
							FontSize="12"
							MaxHeight="200"
							ScrollViewer.HorizontalScrollBarVisibility="Auto"
							ScrollViewer.VerticalScrollBarVisibility="Auto"
							Text="{x:Bind ViewModel.LogPreview.Value, Mode=OneWay}" />
					</StackPanel>
				</Expander>
			</StackPanel>
		</ScrollViewer>

		<!-- フッター -->
		<Border Grid.Row="2"
			Padding="24,12"
			BorderThickness="0,1,0,0"
			BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" >
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0"
					Orientation="Horizontal"
					Spacing="8"
					VerticalAlignment="Center"
					Visibility="{x:Bind ViewModel.IsSubmitting.Value, Mode=OneWay}" >
					<ProgressRing IsActive="{x:Bind ViewModel.IsSubmitting.Value, Mode=OneWay}"
						Width="20"
						Height="20" />
					<TextBlock x:Uid="Feedback_SubmittingText"
						VerticalAlignment="Center"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				</StackPanel>

				<StackPanel Grid.Column="1"
					Orientation="Horizontal"
					HorizontalAlignment="Right"
					Spacing="12" >
					<Button x:Uid="Feedback_CancelButton"
						Command="{x:Bind ViewModel.CancelCommand}"
						MinWidth="110" />
					<Button Style="{StaticResource AccentButtonStyle}"
						Command="{x:Bind ViewModel.SubmitCommand}"
						MinWidth="120" >
						<StackPanel Orientation="Horizontal" Spacing="8" >
							<FontIcon Glyph="&#xE724;" FontSize="14" />
							<TextBlock x:Uid="Feedback_SubmitButton" />
						</StackPanel>
					</Button>
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</Window>
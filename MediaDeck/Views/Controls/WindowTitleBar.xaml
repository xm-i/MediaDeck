<?xml version="1.0" encoding="utf-8" ?>
<UserControl
	x:Class="MediaDeck.Views.Controls.WindowTitleBar"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">
	<Grid
		Height="32"
		Background="{ThemeResource TitleBarBackgroundBrush}"
		Padding="12,0,0,0"
		VerticalAlignment="Top">
		<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
			<Image Source="/Assets/Square44x44Logo.scale-200.png" Width="16" Height="16" Margin="4,0,8,0" />
			<TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" />
		</StackPanel>
	</Grid>
</UserControl>

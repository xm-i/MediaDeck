<?xml version="1.0" encoding="utf-8" ?>
<localControls:GlobalInfoBarUserControl x:Class="MediaDeck.Views.Controls.GlobalInfoBar"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:localControls="using:MediaDeck.Views.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" >
	<Grid Background="Transparent" >
		<InfoBar x:Name="NotificationInfoBar"
			MaxWidth="600"
			IsOpen="{x:Bind ViewModel.IsOpen.Value, Mode=TwoWay}"
			Title="{x:Bind ViewModel.Title.Value, Mode=OneWay}"
			Message="{x:Bind ViewModel.Message.Value, Mode=OneWay}"
			Severity="{x:Bind ToInfoBarSeverity(ViewModel.Severity.Value), Mode=OneWay}"
			IsClosable="True"
			Closed="InfoBar_Closed" />
	</Grid>
</localControls:GlobalInfoBarUserControl>
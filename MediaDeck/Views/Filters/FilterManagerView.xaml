<?xml version="1.0" encoding="utf-8" ?>
<local:FilterManagerViewUserControl x:Class="MediaDeck.Views.Filters.FilterManagerView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Filters"
	xmlns:creatorsViews="using:MediaDeck.Views.Filters.FilterItemCreators"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:creators="using:MediaDeck.ViewModels.Filters.FilterItemCreators"
	xmlns:filterVm="using:MediaDeck.ViewModels.Filters"
	xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
	mc:Ignorable="d" >

	<Grid Padding="16,12" >
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="280" MinWidth="220" MaxWidth="420" />
			<ColumnDefinition Width="12" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!-- 左ペイン: フィルター条件一覧 -->
		<Border Grid.Column="0"
			CornerRadius="8"
			Background="{ThemeResource LayerFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1" >
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<!-- ヘッダー -->
				<Border Grid.Row="0"
					Padding="14,10"
					BorderThickness="0,0,0,1"
					BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" >
					<Grid ColumnSpacing="8" >
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0"
							Orientation="Horizontal"
							Spacing="8"
							VerticalAlignment="Center" >
							<FontIcon Glyph="&#xE71C;"
								FontSize="15"
								Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
							<TextBlock x:Uid="FilterManager_FilteringConditionsTitle"
								Style="{StaticResource BodyStrongTextBlockStyle}"
								VerticalAlignment="Center" />
							<Border Padding="7,1"
								CornerRadius="10"
								Background="{ThemeResource SubtleFillColorSecondaryBrush}"
								VerticalAlignment="Center" >
								<TextBlock Text="{x:Bind ViewModel.ConditionCount.Value, Mode=OneWay}"
									Style="{StaticResource CaptionTextBlockStyle}"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
							</Border>
						</StackPanel>
						<Button Grid.Column="1"
							HorizontalAlignment="Right"
							Command="{x:Bind ViewModel.AddFilteringConditionCommand, Mode=OneWay}"
							Style="{StaticResource AccentButtonStyle}"
							Padding="10,5"
							x:Uid="FilterManager_AddConditionButton" >
							<StackPanel Orientation="Horizontal"
								Spacing="6" >
								<FontIcon Glyph="&#xE710;"
									FontSize="12" />
								<TextBlock x:Uid="FilterManager_AddConditionButton_Text" />
							</StackPanel>
						</Button>
					</Grid>
				</Border>

				<!-- 条件リスト -->
				<ListView Grid.Row="1"
					SelectionMode="Single"
					Padding="6"
					Background="Transparent"
					ItemsSource="{x:Bind ViewModel.FilteringConditions, Mode=OneWay}"
					SelectedItem="{x:Bind ViewModel.CurrentCondition.Value, Mode=TwoWay}" >
					<ListView.ItemContainerStyle>
						<Style TargetType="ListViewItem"
							BasedOn="{StaticResource DefaultListViewItemStyle}" >
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
							<Setter Property="Margin" Value="0,2" />
							<Setter Property="Padding" Value="12,8" />
						</Style>
					</ListView.ItemContainerStyle>
					<ListView.ItemTemplate>
						<DataTemplate x:DataType="filterVm:FilteringConditionEditorViewModel" >
							<StackPanel Spacing="2" >
								<TextBlock Text="{x:Bind DisplayName.Value, Converter={StaticResource StringNullOrEmptyToDefaultConverter}, ConverterParameter=FilterManager_Untitled, Mode=OneWay}"
									FontWeight="SemiBold"
									TextTrimming="CharacterEllipsis" />
								<TextBlock Text="{x:Bind SummaryText.Value, Mode=OneWay}"
									Style="{StaticResource CaptionTextBlockStyle}"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									TextTrimming="CharacterEllipsis" />
							</StackPanel>
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>
			</Grid>
		</Border>

		<!-- 区切り -->
		<toolkit:GridSplitter Grid.Column="1"
			Width="12"
			HorizontalAlignment="Center"
			ResizeBehavior="BasedOnAlignment"
			Background="Transparent" />

		<!-- 右ペイン: フィルター条件編集エリア -->
		<Border Grid.Column="2"
			CornerRadius="8"
			Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1" >
			<Grid Padding="20" >
				<!-- 空状態 (0件) -->
				<StackPanel HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Spacing="14"
					MaxWidth="360"
					Visibility="{x:Bind ViewModel.ShowEmptyMessage.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" >
					<FontIcon Glyph="&#xE71C;"
						FontSize="44"
						HorizontalAlignment="Center"
						Foreground="{ThemeResource TextFillColorDisabledBrush}" />
					<TextBlock x:Uid="FilterManager_EmptyConditionsTitle"
						Style="{StaticResource SubtitleTextBlockStyle}"
						HorizontalAlignment="Center"
						TextAlignment="Center" />
					<TextBlock x:Uid="FilterManager_EmptyConditionsDescription"
						Style="{StaticResource CaptionTextBlockStyle}"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						HorizontalAlignment="Center"
						TextAlignment="Center"
						TextWrapping="Wrap" />
					<Button Command="{x:Bind ViewModel.AddFilteringConditionCommand, Mode=OneWay}"
						Style="{StaticResource AccentButtonStyle}"
						HorizontalAlignment="Center" >
						<StackPanel Orientation="Horizontal"
							Spacing="8" >
							<FontIcon Glyph="&#xE710;"
								FontSize="13" />
							<TextBlock x:Uid="FilterManager_CreateFirstCondition" />
						</StackPanel>
					</Button>
				</StackPanel>

				<!-- 未選択案内 (1件以上) -->
				<StackPanel HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Spacing="14"
					Visibility="{x:Bind ViewModel.ShowSelectConditionMessage.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" >
					<FontIcon Glyph="&#xE71C;"
						FontSize="44"
						HorizontalAlignment="Center"
						Foreground="{ThemeResource TextFillColorDisabledBrush}" />
					<TextBlock x:Uid="FilterManager_SelectConditionMessage"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						HorizontalAlignment="Center"
						TextAlignment="Center" />
				</StackPanel>

				<!-- 編集ビュー -->
				<Grid Visibility="{x:Bind ViewModel.HasCurrentCondition.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" >
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<!-- ヘッダー＆条件名 -->
					<StackPanel Grid.Row="0"
						Spacing="10" >
						<Grid ColumnSpacing="8" >
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0"
								x:Uid="FilterManager_ConditionSettingsHeader"
								FontSize="12"
								FontWeight="SemiBold"
								VerticalAlignment="Center"
								Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
							<Button Grid.Column="1"
								HorizontalAlignment="Right"
								Command="{x:Bind ViewModel.RemoveFilteringConditionCommand, Mode=OneWay}"
								CommandParameter="{x:Bind ViewModel.CurrentCondition.Value, Mode=OneWay}"
								Padding="10,5"
								x:Uid="FilterManager_DeleteConditionButton" >
								<StackPanel Orientation="Horizontal"
									Spacing="6" >
									<FontIcon Glyph="&#xE74D;"
										FontSize="13"
										Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
									<TextBlock x:Uid="FilterManager_DeleteConditionButton_Text"
										FontSize="12"
										Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
								</StackPanel>
							</Button>
						</Grid>
						<StackPanel Spacing="6" >
							<TextBlock x:Uid="FilterManager_ConditionNameLabel"
								FontWeight="SemiBold" />
							<TextBox
								Text="{x:Bind ViewModel.CurrentCondition.Value.DisplayName.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								x:Uid="FilterManager_ConditionNameTextBox" />
						</StackPanel>
					</StackPanel>

					<!-- フィルター項目ビルダーカード -->
					<Border Grid.Row="1"
						Margin="0,16,0,0"
						Padding="14,12"
						Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
						BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
						BorderThickness="1"
						CornerRadius="8" >
						<StackPanel Spacing="10" >
							<TextBlock x:Uid="FilterManager_AddFilterItemLabel"
								FontWeight="SemiBold" />

							<!-- カテゴリチップ群 -->
							<ItemsControl ItemsSource="{x:Bind ViewModel.FilterCreatorViewModels, Mode=OneWay}" >
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<toolkit:WrapPanel HorizontalSpacing="6"
											VerticalSpacing="6" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="creators:IFilterCreatorViewModel" >
										<ToggleButton IsChecked="{x:Bind IsSelected.Value, Mode=OneWay}"
											Tag="{x:Bind}"
											Click="FilterCreatorChip_Click"
											CornerRadius="16"
											Padding="10,5" >
											<StackPanel Orientation="Horizontal"
												Spacing="6" >
												<FontIcon Glyph="{x:Bind IconGlyph}"
													FontSize="13"
													VerticalAlignment="Center" />
												<TextBlock Text="{x:Bind ShortTitle}"
													FontSize="12"
													VerticalAlignment="Center" />
											</StackPanel>
										</ToggleButton>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<Border Height="1"
								Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

							<!-- 選択中カテゴリの説明 -->
							<TextBlock Text="{x:Bind ViewModel.SelectedFilterCreatorViewModel.Value.Description, Mode=OneWay}"
								Style="{StaticResource CaptionTextBlockStyle}"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								TextWrapping="Wrap" />

							<!-- 選択中カテゴリのビルダー -->
							<toolkit:SwitchPresenter TargetType="creators:FilterCreatorKind"
								Value="{x:Bind ViewModel.SelectedFilterCreatorKind.Value, Mode=OneWay}" >
								<toolkit:Case Value="Tag" >
									<creatorsViews:TagFilter ViewModel="{x:Bind ViewModel.TagFilterCreator, Mode=OneWay}" />
								</toolkit:Case>
								<toolkit:Case Value="FilePath" >
									<creatorsViews:FilePathFilter ViewModel="{x:Bind ViewModel.FilePathFilterCreator, Mode=OneWay}" />
								</toolkit:Case>
								<toolkit:Case Value="MediaType" >
									<creatorsViews:MediaTypeFilter ViewModel="{x:Bind ViewModel.MediaTypeFilterCreator, Mode=OneWay}" />
								</toolkit:Case>
								<toolkit:Case Value="Rate" >
									<creatorsViews:RateFilter ViewModel="{x:Bind ViewModel.RateFilterCreator, Mode=OneWay}" />
								</toolkit:Case>
								<toolkit:Case Value="Resolution" >
									<creatorsViews:ResolutionFilter ViewModel="{x:Bind ViewModel.ResolutionFilterCreator, Mode=OneWay}" />
								</toolkit:Case>
								<toolkit:Case Value="Location" >
									<creatorsViews:LocationFilter ViewModel="{x:Bind ViewModel.LocationFilterCreator, Mode=OneWay}" />
								</toolkit:Case>
								<toolkit:Case Value="FolderGroup" >
									<creatorsViews:FolderGroupFilter ViewModel="{x:Bind ViewModel.FolderGroupFilterCreator, Mode=OneWay}" />
								</toolkit:Case>
								<toolkit:Case Value="Exists" >
									<creatorsViews:ExistsFilter ViewModel="{x:Bind ViewModel.ExistsFilterCreator, Mode=OneWay}" />
								</toolkit:Case>
							</toolkit:SwitchPresenter>
						</StackPanel>
					</Border>

					<!-- 適用済みフィルター一覧 -->
					<Grid Grid.Row="2"
						Margin="0,16,0,0" >
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="8" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<Grid Grid.Row="0"
							ColumnSpacing="12" >
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0"
								Orientation="Horizontal"
								Spacing="8"
								VerticalAlignment="Center" >
								<TextBlock x:Uid="FilterManager_ActiveFilterItemsLabel"
									FontWeight="SemiBold"
									VerticalAlignment="Center" />
								<Border Padding="7,1"
									CornerRadius="10"
									Background="{ThemeResource SubtleFillColorSecondaryBrush}"
									VerticalAlignment="Center" >
									<TextBlock Text="{x:Bind ViewModel.CurrentCondition.Value.FilterItemCount.Value, Mode=OneWay}"
										Style="{StaticResource CaptionTextBlockStyle}"
										Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
								</Border>
							</StackPanel>
							<StackPanel Grid.Column="1"
								Orientation="Horizontal"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								Spacing="6" >
								<Border Padding="6,1"
									CornerRadius="4"
									Background="{ThemeResource SubtleFillColorSecondaryBrush}" >
									<TextBlock x:Uid="FilterManager_AndBadge"
										FontSize="11"
										FontWeight="SemiBold"
										Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
								</Border>
								<TextBlock x:Uid="FilterManager_AndHint"
									Style="{StaticResource CaptionTextBlockStyle}"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									VerticalAlignment="Center" />
							</StackPanel>
						</Grid>

						<!-- 0件時空メッセージ -->
						<Border Grid.Row="2"
							Padding="24"
							Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
							BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
							BorderThickness="1"
							CornerRadius="8"
							Visibility="{x:Bind ViewModel.CurrentCondition.Value.IsEmpty.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" >
							<StackPanel HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Spacing="8" >
								<FontIcon Glyph="&#xE71C;"
									FontSize="28"
									HorizontalAlignment="Center"
									Foreground="{ThemeResource TextFillColorDisabledBrush}" />
								<TextBlock x:Uid="FilterManager_EmptyFilterItemsMessage"
									Style="{StaticResource CaptionTextBlockStyle}"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									TextAlignment="Center" />
							</StackPanel>
						</Border>

						<!-- 適用済みルールリスト -->
						<ScrollViewer Grid.Row="2"
							VerticalScrollBarVisibility="Auto"
							Visibility="{x:Bind ViewModel.CurrentCondition.Value.HasFilterItems.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" >
							<ItemsRepeater ItemsSource="{x:Bind ViewModel.CurrentCondition.Value.FilterItems, Mode=OneWay}" >
								<ItemsRepeater.Layout>
									<StackLayout Spacing="6" />
								</ItemsRepeater.Layout>
								<ItemsRepeater.ItemTemplate>
									<DataTemplate x:DataType="filterVm:FilterItemDisplayViewModel" >
										<Border Padding="12,8"
											Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
											BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
											BorderThickness="1"
											CornerRadius="6" >
											<Grid ColumnSpacing="10" >
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="Auto" />
													<ColumnDefinition Width="Auto" />
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="Auto" />
												</Grid.ColumnDefinitions>

												<FontIcon Grid.Column="0"
													Glyph="{x:Bind CategoryIconGlyph}"
													FontSize="15"
													Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
													VerticalAlignment="Center" />

												<Border Grid.Column="1"
													Padding="8,2"
													CornerRadius="4"
													Background="{ThemeResource SubtleFillColorSecondaryBrush}"
													VerticalAlignment="Center" >
													<TextBlock Text="{x:Bind CategoryName}"
														FontSize="11"
														FontWeight="SemiBold"
														Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
												</Border>

												<TextBlock Grid.Column="2"
													Text="{x:Bind DisplayText}"
													VerticalAlignment="Center"
													TextWrapping="Wrap" />

												<Button Grid.Column="3"
													Command="{x:Bind RemoveCommand}"
													Padding="7,5"
													x:Uid="FilterManager_RemoveFilterItemButton" >
													<FontIcon Glyph="&#xE74D;"
														FontSize="13"
														Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
												</Button>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsRepeater.ItemTemplate>
							</ItemsRepeater>
						</ScrollViewer>
					</Grid>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</local:FilterManagerViewUserControl>
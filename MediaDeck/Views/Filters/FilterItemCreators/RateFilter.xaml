<local:RateFilterControlBase x:Class="MediaDeck.Views.Filters.FilterItemCreators.RateFilter"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Filters.FilterItemCreators"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" >
	<Grid ColumnSpacing="8" >
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<RatingControl Grid.Column="0"
			MaxRating="5"
			IsClearEnabled="True"
			VerticalAlignment="Center"
			Value="{x:Bind ViewModel.RatingControlValue.Value, Mode=OneWay}"
			ValueChanged="RatingControl_ValueChanged" />

		<Button Grid.Column="1"
			Command="{x:Bind ViewModel.ClearRateCommand, Mode=OneWay}"
			Padding="8,4"
			VerticalAlignment="Center"
			x:Uid="FilterCreator_Rate_SetZero" />

		<Border Grid.Column="2"
			Padding="8,3"
			CornerRadius="10"
			Background="{ThemeResource SubtleFillColorSecondaryBrush}"
			VerticalAlignment="Center" >
			<TextBlock Text="{x:Bind ViewModel.RateCaption.Value, Mode=OneWay}"
				Style="{StaticResource CaptionTextBlockStyle}"
				FontWeight="SemiBold" />
		</Border>

		<ComboBox Grid.Column="4"
			MinWidth="130"
			VerticalAlignment="Center"
			ItemsSource="{x:Bind ViewModel.SearchTypeList, Mode=OneWay}"
			SelectedItem="{x:Bind ViewModel.SearchType.Value, Mode=TwoWay}"
			ItemTemplate="{StaticResource DisplayObjectComboBoxItemTemplate}" />

		<Button Grid.Column="5"
			Command="{x:Bind ViewModel.AddFilterCommand, Mode=OneWay}"
			Style="{StaticResource AccentButtonStyle}"
			VerticalAlignment="Center" >
			<StackPanel Orientation="Horizontal"
				Spacing="6" >
				<FontIcon Glyph="&#xE710;"
					FontSize="12" />
				<TextBlock x:Uid="FilterCreator_AddFilter_Text" />
			</StackPanel>
		</Button>
	</Grid>
</local:RateFilterControlBase>
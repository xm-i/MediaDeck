<local:MediaTypeFilterControlBase x:Class="MediaDeck.Views.Filters.FilterItemCreators.MediaTypeFilter"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Filters.FilterItemCreators"
	xmlns:creators="using:MediaDeck.ViewModels.Filters.FilterItemCreators"
	xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" >
	<Grid ColumnSpacing="8" >
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<toolkit:Segmented Grid.Column="0"
			SelectionMode="Single"
			ItemsSource="{x:Bind ViewModel.MediaTypeList, Mode=OneWay}"
			SelectedItem="{x:Bind ViewModel.MediaType.Value, Mode=TwoWay}" >
			<toolkit:Segmented.ItemTemplate>
				<DataTemplate x:DataType="creators:MediaTypeOption" >
					<StackPanel Orientation="Horizontal"
						Spacing="6" >
						<FontIcon Glyph="{x:Bind IconGlyph}"
							FontSize="13" />
						<TextBlock Text="{x:Bind DisplayString}"
							VerticalAlignment="Center" />
					</StackPanel>
				</DataTemplate>
			</toolkit:Segmented.ItemTemplate>
		</toolkit:Segmented>

		<Button Grid.Column="2"
			Command="{x:Bind ViewModel.AddFilterCommand, Mode=OneWay}"
			Style="{StaticResource AccentButtonStyle}" >
			<StackPanel Orientation="Horizontal"
				Spacing="6" >
				<FontIcon Glyph="&#xE710;"
					FontSize="12" />
				<TextBlock x:Uid="FilterCreator_AddFilter_Text" />
			</StackPanel>
		</Button>
	</Grid>
</local:MediaTypeFilterControlBase>
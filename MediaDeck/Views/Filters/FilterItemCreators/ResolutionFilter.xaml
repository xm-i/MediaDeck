<local:ResolutionFilterControlBase x:Class="MediaDeck.Views.Filters.FilterItemCreators.ResolutionFilter"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Filters.FilterItemCreators"
	xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" >
	<StackPanel Spacing="8" >
		<Grid ColumnSpacing="8" >
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<NumberBox Grid.Column="0"
				MinWidth="115"
				Minimum="0"
				SpinButtonPlacementMode="Compact"
				Value="{x:Bind ViewModel.WidthValue.Value, Mode=TwoWay}"
				x:Uid="FilterCreator_Resolution_WidthPlaceholder" />

			<TextBlock Grid.Column="1"
				Text="×"
				VerticalAlignment="Center"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

			<NumberBox Grid.Column="2"
				MinWidth="115"
				Minimum="0"
				SpinButtonPlacementMode="Compact"
				Value="{x:Bind ViewModel.HeightValue.Value, Mode=TwoWay}"
				x:Uid="FilterCreator_Resolution_HeightPlaceholder" />

			<ComboBox Grid.Column="4"
				MinWidth="120"
				ItemsSource="{x:Bind ViewModel.SearchTypeList, Mode=OneWay}"
				SelectedItem="{x:Bind ViewModel.SearchType.Value, Mode=TwoWay}"
				ItemTemplate="{StaticResource DisplayObjectComboBoxItemTemplate}" />

			<Button Grid.Column="5"
				Command="{x:Bind ViewModel.AddFilterCommand, Mode=OneWay}"
				Style="{StaticResource AccentButtonStyle}" >
				<StackPanel Orientation="Horizontal"
					Spacing="6" >
					<FontIcon Glyph="&#xE710;"
						FontSize="12" />
					<TextBlock x:Uid="FilterCreator_AddFilter_Text" />
				</StackPanel>
			</Button>
		</Grid>

		<StackPanel Spacing="6" >
			<toolkit:WrapPanel HorizontalSpacing="6"
				VerticalSpacing="4" >
				<TextBlock x:Uid="FilterCreator_Resolution_PresetLabel"
					Style="{StaticResource CaptionTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					VerticalAlignment="Center" />
				<Button Content="HD (1280×720)"
					Command="{x:Bind ViewModel.ApplyPresetCommand, Mode=OneWay}"
					CommandParameter="HD"
					Padding="8,2"
					FontSize="11" />
				<Button Content="Full HD (1920×1080)"
					Command="{x:Bind ViewModel.ApplyPresetCommand, Mode=OneWay}"
					CommandParameter="FHD"
					Padding="8,2"
					FontSize="11" />
				<Button Content="4K (3840×2160)"
					Command="{x:Bind ViewModel.ApplyPresetCommand, Mode=OneWay}"
					CommandParameter="4K"
					Padding="8,2"
					FontSize="11" />
				<Button x:Uid="FilterCreator_Resolution_Clear"
					Command="{x:Bind ViewModel.ClearResolutionCommand, Mode=OneWay}"
					Padding="8,2"
					FontSize="11" />
			</toolkit:WrapPanel>
			<TextBlock x:Uid="FilterCreator_Resolution_Hint"
				Style="{StaticResource CaptionTextBlockStyle}"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				TextWrapping="Wrap" />
		</StackPanel>
	</StackPanel>
</local:ResolutionFilterControlBase>
<local:TagFilterControlBase x:Class="MediaDeck.Views.Filters.FilterItemCreators.TagFilter"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Filters.FilterItemCreators"
	xmlns:creators="using:MediaDeck.ViewModels.Filters.FilterItemCreators"
	xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" >
	<Grid ColumnSpacing="8" >
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<AutoSuggestBox Grid.Column="0"
			MinWidth="200"
			HorizontalAlignment="Stretch"
			x:Uid="FilterCreator_Tag_Placeholder"
			ItemsSource="{x:Bind ViewModel.TagSuggestions.Value, Mode=OneWay}"
			Text="{x:Bind ViewModel.TagName.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			TextMemberPath="TagName"
			TextChanged="AutoSuggestBox_TextChanged"
			SuggestionChosen="AutoSuggestBox_SuggestionChosen"
			QuerySubmitted="AutoSuggestBox_QuerySubmitted" >
			<AutoSuggestBox.QueryIcon>
				<FontIcon Glyph="&#xE8EC;"
					FontSize="13" />
			</AutoSuggestBox.QueryIcon>
			<AutoSuggestBox.ItemTemplate>
				<DataTemplate x:DataType="creators:TagSuggestionItem" >
					<Grid Padding="2,4"
						ColumnSpacing="8" >
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0"
							Spacing="1" >
							<TextBlock Text="{x:Bind TagName}"
								TextTrimming="CharacterEllipsis" />
							<TextBlock Text="{x:Bind AliasText}"
								Visibility="{x:Bind HasAliasText, Converter={StaticResource BoolToVisibilityConverter}}"
								Style="{StaticResource CaptionTextBlockStyle}"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								TextTrimming="CharacterEllipsis" />
						</StackPanel>
						<TextBlock Grid.Column="1"
							VerticalAlignment="Center"
							Style="{StaticResource CaptionTextBlockStyle}"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}" >
							<Run Text="(" />
							<Run Text="{x:Bind UsageCount}" />
							<Run Text=")" />
						</TextBlock>
					</Grid>
				</DataTemplate>
			</AutoSuggestBox.ItemTemplate>
		</AutoSuggestBox>

		<toolkit:Segmented Grid.Column="1"
			SelectionMode="Single"
			ItemsSource="{x:Bind ViewModel.SearchTypeList, Mode=OneWay}"
			SelectedItem="{x:Bind ViewModel.SearchType.Value, Mode=TwoWay}"
			DisplayMemberPath="DisplayString" />

		<Button Grid.Column="2"
			Command="{x:Bind ViewModel.AddFilterCommand, Mode=OneWay}"
			Style="{StaticResource AccentButtonStyle}" >
			<StackPanel Orientation="Horizontal"
				Spacing="6" >
				<FontIcon Glyph="&#xE710;"
					FontSize="12" />
				<TextBlock x:Uid="FilterCreator_AddFilter_Text" />
			</StackPanel>
		</Button>
	</Grid>
</local:TagFilterControlBase>
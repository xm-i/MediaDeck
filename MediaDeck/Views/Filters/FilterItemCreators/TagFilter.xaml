<local:TagFilterPageBase x:Class="MediaDeck.Views.Filters.FilterItemCreators.TagFilter"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Filters.FilterItemCreators"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" >
	<StackPanel Orientation="Horizontal" >
		<TextBlock x:Uid="FilterCreator_Tag_Prefix" />
		<TextBox Width="200"
			Text="{x:Bind ViewModel.TagName.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
		<TextBlock x:Uid="FilterCreator_Tag_Suffix" />
		<ComboBox ItemsSource="{x:Bind ViewModel.SearchTypeList}"
			SelectedItem="{x:Bind ViewModel.SearchType.Value, Mode=TwoWay}"
			ItemTemplate="{StaticResource DisplayObjectComboBoxItemTemplate}" />
		<Button Command="{x:Bind ViewModel.AddFilterCommand}"
			x:Uid="FilterCreator_AddFilter" />
	</StackPanel>
</local:TagFilterPageBase>
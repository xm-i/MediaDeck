<local:TagDetailViewUserControl x:Class="MediaDeck.Views.Tags.TagDetailView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Tags"
	xmlns:tags="using:MediaDeck.ViewModels.Tags"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" >

	<Border Padding="16"
		Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
		BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
		BorderThickness="1"
		CornerRadius="8" >
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="16" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="16" />
				<RowDefinition Height="*" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- タグ名入力 -->
			<StackPanel Grid.Row="0"
				Spacing="6" >
				<TextBlock x:Uid="TagManager_TagName"
					FontWeight="SemiBold" />
				<TextBox
					Text="{x:Bind ViewModel.TagName.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					x:Uid="TagManager_TagNameInput" />
				
				<TextBlock x:Uid="TagManager_Ruby"
					FontWeight="SemiBold"
					Margin="0,8,0,0" />
				<TextBox
					Text="{x:Bind ViewModel.Ruby.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					x:Uid="TagManager_RubyInput" />
			</StackPanel>

			<!-- カテゴリ選択 -->
			<StackPanel Grid.Row="2"
				Spacing="6" >
				<TextBlock x:Uid="TagManager_ParentCategory"
					FontWeight="SemiBold" />
				<ComboBox HorizontalAlignment="Stretch"
					ItemsSource="{x:Bind Categories, Mode=OneWay}"
					SelectedItem="{x:Bind ViewModel.TagCategory.Value, Mode=TwoWay}" >
					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="tags:TagCategoryViewModel" >
							<TextBlock Text="{x:Bind TagCategoryName.Value, Mode=OneWay}" />
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
			</StackPanel>

			<!-- エイリアス一覧 -->
			<Grid Grid.Row="4" >
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="8" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<TextBlock Grid.Row="0"
					x:Uid="TagManager_Aliases"
					FontWeight="SemiBold" />

				<Border Grid.Row="2"
					BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
					BorderThickness="1"
					CornerRadius="4" >
					<ScrollViewer>
						<ItemsControl
							ItemsSource="{x:Bind ViewModel.TagAliases, Mode=OneWay}" >
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="tags:TagAliasViewModel" >
									<Grid Padding="8"
										BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
										BorderThickness="0,0,0,1" >
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="8" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="8" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<TextBox Grid.Column="0"
											Text="{x:Bind Alias.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											x:Uid="TagManager_AliasInput" />
										<TextBox Grid.Column="2"
											Text="{x:Bind Ruby.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											x:Uid="TagManager_RubyInputShort" />
										<Button Grid.Column="4"
											Command="{x:Bind Parent.RemoveTagAliasCommand, Mode=OneWay}"
											CommandParameter="{x:Bind Mode=OneWay}"
											x:Uid="Common_Delete_ToolTip"
											Padding="6" >
											<FontIcon Glyph="&#xF78A;"
												FontSize="12" />
										</Button>
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Border>
			</Grid>

			<!-- ボタンエリア -->
			<Grid Grid.Row="6">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				
				<!-- エイリアス追加ボタン -->
				<Button Grid.Column="0"
					Command="{x:Bind ViewModel.AddTagAliasCommand, Mode=OneWay}" >
					<StackPanel Orientation="Horizontal"
						Spacing="6" >
						<FontIcon Glyph="&#xF8AA;"
							FontSize="12" />
						<TextBlock x:Uid="TagManager_AddAlias" />
					</StackPanel>
				</Button>

				<!-- タグ削除ボタン -->
				<Button Grid.Column="2" 
					Click="DeleteTagButton_Click" >
					<StackPanel Orientation="Horizontal" Spacing="6">
						<FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
						<TextBlock x:Uid="TagManager_DeleteTag" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
					</StackPanel>
				</Button>
			</Grid>
		</Grid>
	</Border>
</local:TagDetailViewUserControl>

<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="MediaDeck.Views.Tags.TagCategoryEditDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	x:Uid="TagCategoryEditDialog"
	Title="{x:Bind ViewModel.DialogTitle.Value, Mode=OneWay}"
	PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText.Value, Mode=OneWay}"
	IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSave.Value, Mode=OneWay}"
	DefaultButton="Primary"
	PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
	MinWidth="400" >
	<StackPanel Spacing="16"
		Margin="0,8,0,0" >
		<StackPanel Spacing="6" >
			<TextBlock x:Uid="TagCategoryEditDialog_NameLabel"
				FontWeight="SemiBold" />
			<TextBox x:Name="CategoryNameTextBox"
				Text="{x:Bind ViewModel.TagCategoryName.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
				x:Uid="TagCategoryEditDialog_NameInput"
				Loaded="CategoryNameTextBox_Loaded" />
		</StackPanel>
		<StackPanel Spacing="6" >
			<TextBlock x:Uid="TagCategoryEditDialog_DetailLabel"
				FontWeight="SemiBold" />
			<TextBox
				Text="{x:Bind ViewModel.Detail.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
				x:Uid="TagCategoryEditDialog_DetailInput"
				Height="80"
				AcceptsReturn="True"
				TextWrapping="Wrap"
				ScrollViewer.VerticalScrollBarVisibility="Auto" />
		</StackPanel>
	</StackPanel>
</ContentDialog>
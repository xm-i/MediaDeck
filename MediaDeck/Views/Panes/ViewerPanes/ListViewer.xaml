<?xml version="1.0" encoding="utf-8" ?>
<local:ListViewerUserControl x:Class="MediaDeck.Views.Panes.ViewerPanes.ListViewer"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Panes.ViewerPanes"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vmIf="using:MediaDeck.Composition.Interfaces.MediaItemTypes.ViewModels"
	xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
	mc:Ignorable="d" >
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Border Grid.Row="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" >
			<ScrollViewer x:Name="HeaderScrollViewer" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden" >
				<Grid Height="32" RightTapped="HeaderGrid_RightTapped" >
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="{x:Bind ViewModel.ItemSize.Value, Mode=OneWay, Converter={StaticResource DoubleToGridLengthConverter}}" MinWidth="{x:Bind ViewModel.ItemSize.Value, Mode=OneWay}" />
						<ColumnDefinition Width="{x:Bind ViewModel.FileNameColumn.EffectiveWidth.Value, Mode=OneWay, Converter={StaticResource DoubleToGridLengthConverter}}" MinWidth="{x:Bind ViewModel.FileNameColumn.EffectiveMinWidth.Value, Mode=OneWay}" />
						<ColumnDefinition Width="{x:Bind ViewModel.ResolutionColumn.EffectiveWidth.Value, Mode=OneWay, Converter={StaticResource DoubleToGridLengthConverter}}" MinWidth="{x:Bind ViewModel.ResolutionColumn.EffectiveMinWidth.Value, Mode=OneWay}" />
						<ColumnDefinition Width="{x:Bind ViewModel.FileSizeColumn.EffectiveWidth.Value, Mode=OneWay, Converter={StaticResource DoubleToGridLengthConverter}}" MinWidth="{x:Bind ViewModel.FileSizeColumn.EffectiveMinWidth.Value, Mode=OneWay}" />
						<ColumnDefinition Width="{x:Bind ViewModel.CreationTimeColumn.EffectiveWidth.Value, Mode=OneWay, Converter={StaticResource DoubleToGridLengthConverter}}" MinWidth="{x:Bind ViewModel.CreationTimeColumn.EffectiveMinWidth.Value, Mode=OneWay}" />
						<ColumnDefinition Width="{x:Bind ViewModel.RateColumn.EffectiveWidth.Value, Mode=OneWay, Converter={StaticResource DoubleToGridLengthConverter}}" MinWidth="{x:Bind ViewModel.RateColumn.EffectiveMinWidth.Value, Mode=OneWay}" />
					</Grid.ColumnDefinitions>
					<Grid Grid.Column="0" />
					<Grid Grid.Column="1" Visibility="{x:Bind ViewModel.FileNameColumn.IsVisible.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" >
						<TextBlock x:Uid="Viewer_ColumnFileName" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis" />
						<primitives:Thumb Tag="{x:Bind ViewModel.FileNameColumn, Mode=OneWay}" Width="6" HorizontalAlignment="Right" DragDelta="HeaderResizer_DragDelta" PointerEntered="HeaderResizer_PointerEntered" PointerExited="HeaderResizer_PointerExited" />
					</Grid>
					<Grid Grid.Column="2" Visibility="{x:Bind ViewModel.ResolutionColumn.IsVisible.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" >
						<TextBlock x:Uid="Viewer_ColumnResolution" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis" />
						<primitives:Thumb Tag="{x:Bind ViewModel.ResolutionColumn, Mode=OneWay}" Width="6" HorizontalAlignment="Right" DragDelta="HeaderResizer_DragDelta" PointerEntered="HeaderResizer_PointerEntered" PointerExited="HeaderResizer_PointerExited" />
					</Grid>
					<Grid Grid.Column="3" Visibility="{x:Bind ViewModel.FileSizeColumn.IsVisible.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" >
						<TextBlock x:Uid="Viewer_ColumnSize" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis" />
						<primitives:Thumb Tag="{x:Bind ViewModel.FileSizeColumn, Mode=OneWay}" Width="6" HorizontalAlignment="Right" DragDelta="HeaderResizer_DragDelta" PointerEntered="HeaderResizer_PointerEntered" PointerExited="HeaderResizer_PointerExited" />
					</Grid>
					<Grid Grid.Column="4" Visibility="{x:Bind ViewModel.CreationTimeColumn.IsVisible.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" >
						<TextBlock x:Uid="Viewer_ColumnCreationTime" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis" />
						<primitives:Thumb Tag="{x:Bind ViewModel.CreationTimeColumn, Mode=OneWay}" Width="6" HorizontalAlignment="Right" DragDelta="HeaderResizer_DragDelta" PointerEntered="HeaderResizer_PointerEntered" PointerExited="HeaderResizer_PointerExited" />
					</Grid>
					<Grid Grid.Column="5" Visibility="{x:Bind ViewModel.RateColumn.IsVisible.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" >
						<TextBlock x:Uid="Viewer_ColumnRate" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis" />
						<primitives:Thumb Tag="{x:Bind ViewModel.RateColumn, Mode=OneWay}" Width="6" HorizontalAlignment="Right" DragDelta="HeaderResizer_DragDelta" PointerEntered="HeaderResizer_PointerEntered" PointerExited="HeaderResizer_PointerExited" />
					</Grid>
				</Grid>
			</ScrollViewer>
		</Border>
		<ListView x:Name="List" Grid.Row="1" ItemsSource="{x:Bind ViewModel.MediaContentLibraryViewModel.Files, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.MediaContentLibraryViewModel.SelectedFile.Value, Mode=TwoWay}" SelectionMode="Extended" SelectionChanged="List_SelectionChanged" RightTapped="List_RightTapped" ScrollViewer.HorizontalScrollMode="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" >
			<ListView.ItemContainerStyle>
				<Style TargetType="ListViewItem" >
					<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					<Setter Property="VerticalContentAlignment" Value="Top" />
					<Setter Property="Padding" Value="0" />
					<Setter Property="Margin" Value="0" />
					<Setter Property="MinHeight" Value="0" />
				</Style>
			</ListView.ItemContainerStyle>
			<ListView.ItemsPanel>
				<ItemsPanelTemplate>
					<ItemsStackPanel />
				</ItemsPanelTemplate>
			</ListView.ItemsPanel>
			<ListView.Resources>
				<MenuFlyout x:Key="FileContextMenu" Opening="FileContextMenu_Opening" >
					<MenuFlyoutSubItem x:Uid="Viewer_ContextAddToAlbum" Tag="AddToAlbumRoot" />
					<MenuFlyoutItem x:Uid="Viewer_ContextRecreateThumbnail" Click="MenuFlyoutItem_Click" Tag="RecreateThumbnail" />
					<MenuFlyoutItem x:Uid="Viewer_ContextUpdateMetadata" Click="MenuFlyoutItem_Click" Tag="UpdateMetadata" />
					<MenuFlyoutItem x:Uid="Viewer_ContextRemoveFile" Click="MenuFlyoutItem_Click" Tag="RemoveFile" />
					<MenuFlyoutItem x:Uid="Viewer_ContextOpenFolder" Click="MenuFlyoutItem_Click" Tag="OpenFolder" />
				</MenuFlyout>
			</ListView.Resources>
			<ListView.ItemTemplate>
				<DataTemplate x:DataType="vmIf:IMediaItemViewModel" >
					<Grid DoubleTapped="File_DoubleTapped" >
						<StackPanel Orientation="Horizontal" >
							<Border Width="{Binding DataContext.ItemSize.Value, Mode=OneWay, ElementName=List}" >
								<ContentControl Margin="4" Content="{x:Bind}" ContentTemplateSelector="{StaticResource MediaItemThumbnailControlTplSel}" Height="{Binding DataContext.ItemSize.Value, Mode=OneWay, ElementName=List}" Width="{Binding DataContext.ItemSize.Value, Mode=OneWay, ElementName=List}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
							</Border>
							<Border Width="{Binding DataContext.FileNameColumn.EffectiveWidth.Value, Mode=OneWay, ElementName=List}" Visibility="{Binding DataContext.FileNameColumn.IsVisible.Value, Mode=OneWay, ElementName=List, Converter={StaticResource BoolToVisibilityConverter}}" >
								<TextBlock Text="{x:Bind FilePath}" VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis" />
							</Border>
							<Border Width="{Binding DataContext.ResolutionColumn.EffectiveWidth.Value, Mode=OneWay, ElementName=List}" Visibility="{Binding DataContext.ResolutionColumn.IsVisible.Value, Mode=OneWay, ElementName=List, Converter={StaticResource BoolToVisibilityConverter}}" >
								<TextBlock Text="{x:Bind FileModel.Resolution}" VerticalAlignment="Center" Margin="8,0,8,0" />
							</Border>
							<Border Width="{Binding DataContext.FileSizeColumn.EffectiveWidth.Value, Mode=OneWay, ElementName=List}" Visibility="{Binding DataContext.FileSizeColumn.IsVisible.Value, Mode=OneWay, ElementName=List, Converter={StaticResource BoolToVisibilityConverter}}" >
								<TextBlock Text="{x:Bind FileModel.FileSize, Converter={StaticResource FileSizeConverter}}" VerticalAlignment="Center" Margin="8,0,8,0" />
							</Border>
							<Border Width="{Binding DataContext.CreationTimeColumn.EffectiveWidth.Value, Mode=OneWay, ElementName=List}" Visibility="{Binding DataContext.CreationTimeColumn.IsVisible.Value, Mode=OneWay, ElementName=List, Converter={StaticResource BoolToVisibilityConverter}}" >
								<TextBlock Text="{x:Bind FileModel.CreationTime}" VerticalAlignment="Center" Margin="8,0,8,0" />
							</Border>
							<Border Width="{Binding DataContext.RateColumn.EffectiveWidth.Value, Mode=OneWay, ElementName=List}" Visibility="{Binding DataContext.RateColumn.IsVisible.Value, Mode=OneWay, ElementName=List, Converter={StaticResource BoolToVisibilityConverter}}" >
								<TextBlock Text="{x:Bind FileModel.Rate}" VerticalAlignment="Center" Margin="8,0,8,0" />
							</Border>
						</StackPanel>
						<Grid Opacity="0.7" Background="DarkGray" Visibility="{x:Bind Exists, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
					</Grid>
				</DataTemplate>
			</ListView.ItemTemplate>
			<ListView.Footer>
				<Button x:Uid="Viewer_LoadMore"
					Command="{x:Bind ViewModel.MediaContentLibraryViewModel.LoadMoreCommand}"
					Visibility="{x:Bind ViewModel.MediaContentLibraryViewModel.CanLoadMore.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
					HorizontalAlignment="Stretch" Margin="8" />
			</ListView.Footer>
		</ListView>
	</Grid>
</local:ListViewerUserControl>

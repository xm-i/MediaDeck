<?xml version="1.0" encoding="utf-8" ?>
<local:FilterSelectorUserControl x:Class="MediaDeck.Views.Panes.FilterPanes.FilterSelector"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Panes.FilterPanes"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:filtersVm="using:MediaDeck.ViewModels.Panes.FilterPanes"
	xmlns:controls="using:MediaDeck.Views.Controls"
	mc:Ignorable="d" >

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- Header -->
		<controls:PaneHeaderControl Grid.Row="0"
			x:Uid="Filter_Header"
			Glyph="&#xE71C;">
			<Button
				x:Uid="Filter_Settings"
				Click="OpenFilterSettingsWindowButton_Click" >
				<FontIcon Glyph="&#xE713;"
					FontSize="14" />
			</Button>
		</controls:PaneHeaderControl>

		<!-- Content -->
		<Border Grid.Row="1"
			Background="{ThemeResource LayerFillColorDefaultBrush}" >
			<ListView x:Name="FilteringConditionListBox"
				Padding="8"
				SelectionMode="Multiple"
				ItemsSource="{x:Bind ViewModel.FilteringConditions, Mode=OneWay}"
				SelectionChanged="FilteringConditionListBox_SelectionChanged" >
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="filtersVm:FilteringConditionViewModel" >
						<TextBlock Text="{x:Bind DisplayName.Value, Mode=OneWay, TargetNullValue=NoName}"
							Padding="4,6" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ListView>
		</Border>
	</Grid>
</local:FilterSelectorUserControl>
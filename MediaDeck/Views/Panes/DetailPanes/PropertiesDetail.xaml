<?xml version="1.0" encoding="utf-8" ?>
<local:DetailPaneBase x:Class="MediaDeck.Views.Panes.DetailPanes.PropertiesDetail"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Panes.DetailPanes"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:metadata="using:MediaDeck.Composition.Tables.Metadata"
	xmlns:primitives="using:MediaDeck.Core.Primitives"
	mc:Ignorable="d" >

	<StackPanel Spacing="12" >
		<!-- Rating Section -->
		<StackPanel Spacing="4" >
			<TextBlock x:Uid="Details_Rating"
				Style="{ThemeResource CaptionTextBlockStyle}"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
			<RatingControl Value="{x:Bind ViewModel.Rate.Value, Mode=OneWay}"
				IsClearEnabled="True"
				Caption="{x:Bind ViewModel.Rate.Value, Mode=OneWay}"
				ValueChanged="RatingControl_ValueChanged"/>
		</StackPanel>

		<!-- Properties Section -->
		<StackPanel Spacing="8" >
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="120" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Column="0"
					x:Uid="Details_UsageCount"
					Style="{ThemeResource CaptionTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					IsTextSelectionEnabled="True"
					VerticalAlignment="Center" />
				<TextBlock Grid.Column="1"
					Text="{x:Bind ViewModel.UsageCount.Value, Mode=OneWay}"
					IsTextSelectionEnabled="True"
					VerticalAlignment="Center" />
			</Grid>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="120" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Column="0"
					x:Uid="Details_FilePath"
					Style="{ThemeResource CaptionTextBlockStyle}"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					IsTextSelectionEnabled="True"
					VerticalAlignment="Top" />
				<TextBlock Grid.Column="1"
					Text="{x:Bind ViewModel.RepresentativeFilePath.Value, Mode=OneWay}"
					IsTextSelectionEnabled="True"
					TextWrapping="Wrap" />
			</Grid>
		</StackPanel>

		<!-- Dynamic Properties -->
		<ItemsRepeater ItemsSource="{x:Bind ViewModel.Properties.Value, Mode=OneWay}" >
			<ItemsRepeater.ItemTemplate>
				<DataTemplate x:DataType="primitives:FileProperty">
					<Grid Margin="0,2">
						<Grid Visibility="{x:Bind HasMultipleValues, Converter={StaticResource InvertBoolToVisibilityConverter}}" >
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="120" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0"
								Text="{x:Bind Title}"
								Style="{ThemeResource CaptionTextBlockStyle}"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								IsTextSelectionEnabled="True"
								VerticalAlignment="Center" />
							<TextBlock Grid.Column="1"
								Text="{x:Bind RepresentativeValue.Value}"
								IsTextSelectionEnabled="True"
								VerticalAlignment="Center"
								TextWrapping="Wrap" />
						</Grid>
						<Grid Visibility="{x:Bind HasMultipleValues, Converter={StaticResource BoolToVisibilityConverter}}" >
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="120" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0"
								Text="{x:Bind Title}"
								Style="{ThemeResource CaptionTextBlockStyle}"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								IsTextSelectionEnabled="True"
								VerticalAlignment="Center" />
							<TextBlock Grid.Column="1"
								x:Uid="Details_MultipleValues"
								Foreground="{ThemeResource TextFillColorTertiaryBrush}"
								FontStyle="Italic"
								VerticalAlignment="Center" />
						</Grid>
					</Grid>
				</DataTemplate>
			</ItemsRepeater.ItemTemplate>
		</ItemsRepeater>
		
		<!-- Metadata Section -->
		<Expander x:Uid="Details_Metadata" 
				  HorizontalAlignment="Stretch" 
				  HorizontalContentAlignment="Stretch"
				  Visibility="{x:Bind ViewModel.Metadata.Value, Mode=OneWay, Converter={StaticResource NullToCollapseConverter}}">
			<ItemsRepeater ItemsSource="{x:Bind ViewModel.Metadata.Value.Entries, Mode=OneWay}">
				<ItemsRepeater.ItemTemplate>
					<DataTemplate x:DataType="metadata:MediaMetadataEntry">
						<Grid Margin="0,2">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="120" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0"
								Text="{x:Bind Key}"
								Style="{ThemeResource CaptionTextBlockStyle}"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								IsTextSelectionEnabled="True"
								VerticalAlignment="Center" />
							<TextBlock Grid.Column="1"
								Text="{x:Bind Value}"
								IsTextSelectionEnabled="True"
								VerticalAlignment="Center"
								TextWrapping="Wrap" />
						</Grid>
					</DataTemplate>
				</ItemsRepeater.ItemTemplate>
			</ItemsRepeater>
		</Expander>

		<!-- Description Section -->
		<StackPanel Spacing="8" >
			<TextBlock x:Uid="Details_Description"
				Style="{ThemeResource CaptionTextBlockStyle}"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
			<TextBox x:Uid="Details_DescriptionInput"
				Text="{x:Bind ViewModel.Description.Value, Mode=TwoWay}"
				AcceptsReturn="True"
				MinHeight="80"
				TextWrapping="Wrap" />
			<Button x:Uid="Details_UpdateDescription"
				Command="{x:Bind ViewModel.UpdateDescriptionCommand}"
				HorizontalAlignment="Right" />
		</StackPanel>
	</StackPanel>
</local:DetailPaneBase>
<?xml version="1.0" encoding="utf-8" ?>
<local:SortPaneUserControl x:Class="MediaDeck.Views.Panes.SortPanes.SortPane"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Panes.SortPanes"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:sortpanesVm="using:MediaDeck.ViewModels.Panes.SortPanes"
	xmlns:controls="using:MediaDeck.Views.Controls"
	mc:Ignorable="d" >

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Header -->
		<controls:PaneHeaderControl Grid.Row="0"
			x:Uid="Sort_Header"
			Glyph="&#xE8CB;">
			<Button
				x:Uid="Sort_Settings"
				Click="OpenSortSettingsWindowButton_Click" >
				<FontIcon Glyph="&#xE713;"
					FontSize="14" />
			</Button>
		</controls:PaneHeaderControl>

		<!-- Content -->
		<StackPanel Grid.Row="1"
			Padding="12,8"
			Spacing="6"
			Background="{ThemeResource LayerFillColorDefaultBrush}" >
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<ComboBox Grid.Column="0"
					x:Name="CurrentCondition"
					HorizontalAlignment="Stretch"
					ItemsSource="{x:Bind ViewModel.SortConditions, Mode=OneWay}"
					SelectedItem="{x:Bind ViewModel.CurrentCondition.Value, Mode=OneWay}"
					SelectionChanged="CurrentCondition_SelectionChanged">
					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="sortpanesVm:SortConditionViewModel" >
							<TextBlock Text="{x:Bind DisplayName.Value, Converter={StaticResource StringNullOrEmptyToDefaultConverter}, ConverterParameter=SortManager_Untitled, Mode=OneWay}"
								ToolTipService.ToolTip="{x:Bind SummaryText.Value, Mode=OneWay}"
								TextTrimming="CharacterEllipsis" />
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
				<ToggleButton Grid.Column="1"
					x:Name="DirectionToggleButton"
					Margin="6,0,0,0"
					ToolTipService.ToolTip="{x:Bind ViewModel.DirectionDisplayName.Value, Mode=OneWay}"
					IsChecked="{x:Bind ViewModel.Direction.Value, Mode=OneWay, Converter={StaticResource ListSortDirectionToBooleanConverter}}"
					Checked="DirectionToggleButton_Checked"
					Unchecked="DirectionToggleButton_Unchecked" >
					<FontIcon
						Glyph="{x:Bind ViewModel.Direction.Value, Mode=OneWay, Converter={StaticResource ListSortDirectionToIconGlyphConverter}}"
						FontSize="14" />
				</ToggleButton>
			</Grid>

			<TextBlock Text="{x:Bind ViewModel.CurrentConditionSummary.Value, Mode=OneWay}"
				Style="{StaticResource CaptionTextBlockStyle}"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				TextTrimming="CharacterEllipsis"
				ToolTipService.ToolTip="{x:Bind ViewModel.CurrentConditionSummary.Value, Mode=OneWay}"
				Visibility="{x:Bind ViewModel.CurrentConditionSummary.Value, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
		</StackPanel>
	</Grid>
</local:SortPaneUserControl>

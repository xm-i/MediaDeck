<?xml version="1.0" encoding="utf-8" ?>
<local:RepositorySelectorUserControl x:Class="MediaDeck.Views.Panes.RepositoryPanes.RepositorySelector"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Panes.RepositoryPanes"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	xmlns:vControls="using:MediaDeck.Views.Controls"
	mc:Ignorable="d" >

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- Header -->
		<vControls:PaneHeaderControl Grid.Row="0"
			x:Uid="Repository_Header"
			Glyph="&#xE8B7;">
			<controls:Segmented
				SelectionMode="Single"
				ItemsSource="{x:Bind ViewModel.RepositoryPaneViewModels, Mode=OneWay}"
				SelectedItem="{x:Bind ViewModel.SelectedRepositoryPane.Value, Mode=TwoWay}"
				DisplayMemberPath="Name" />
		</vControls:PaneHeaderControl>

		<!-- Content -->
		<Border Grid.Row="1"
			Background="{ThemeResource LayerFillColorDefaultBrush}" >
			<controls:SwitchPresenter
				Value="{x:Bind ViewModel.SelectedRepositoryPane.Value,Mode=OneWay}" >
				<controls:Case Value="{x:Bind ViewModel.FolderRepositoryViewModel,Mode=OneWay}" >
					<local:FolderRepository ViewModel="{x:Bind ViewModel.FolderRepositoryViewModel,Mode=OneWay}"
						Padding="8" />
				</controls:Case>
				<controls:Case Value="{x:Bind ViewModel.AlbumRepositoryViewModel,Mode=OneWay}" >
					<local:AlbumRepository ViewModel="{x:Bind ViewModel.AlbumRepositoryViewModel,Mode=OneWay}"
						Padding="8" />
				</controls:Case>
			</controls:SwitchPresenter>
		</Border>
	</Grid>
</local:RepositorySelectorUserControl>

<?xml version="1.0" encoding="utf-8" ?>
<local:RepositorySelectorUserControl x:Class="MediaDeck.Views.Panes.RepositoryPanes.RepositorySelector"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Panes.RepositoryPanes"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	mc:Ignorable="d" >

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!-- Header -->
		<Grid Grid.Row="0"
			Padding="12,10"
			Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="0,0,0,1" >
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<StackPanel Grid.Column="0"
				Orientation="Horizontal"
				Spacing="8"
				VerticalAlignment="Center" >
				<FontIcon Glyph="&#xE8B7;"
					FontSize="16" />
				<TextBlock x:Uid="Repository_Header"
					Style="{ThemeResource BodyStrongTextBlockStyle}"
					VerticalAlignment="Center" />
			</StackPanel>
			<controls:Segmented Grid.Column="2"
				SelectionMode="Single"
				ItemsSource="{x:Bind ViewModel.RepositoryPaneViewModels, Mode=OneWay}"
				SelectedItem="{x:Bind ViewModel.SelectedRepositoryPane.Value, Mode=TwoWay}"
				DisplayMemberPath="Name" />
		</Grid>

		<!-- Content -->
		<Border Grid.Row="1"
			Background="{ThemeResource LayerFillColorDefaultBrush}" >
			<controls:SwitchPresenter
				Value="{x:Bind ViewModel.SelectedRepositoryPane.Value,Mode=OneWay}" >
				<controls:Case Value="{x:Bind ViewModel.FolderRepositoryViewModel,Mode=OneWay}" >
					<local:FolderRepository ViewModel="{x:Bind ViewModel.FolderRepositoryViewModel,Mode=OneWay}"
						Padding="8" />
				</controls:Case>
				<controls:Case Value="{x:Bind ViewModel.AlbumRepositoryViewModel,Mode=OneWay}" >
					<local:AlbumRepository ViewModel="{x:Bind ViewModel.AlbumRepositoryViewModel,Mode=OneWay}"
						Padding="8" />
				</controls:Case>
			</controls:SwitchPresenter>
		</Border>
	</Grid>
</local:RepositorySelectorUserControl>

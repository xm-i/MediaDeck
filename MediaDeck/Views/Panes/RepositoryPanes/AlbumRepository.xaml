<?xml version="1.0" encoding="utf-8" ?>
<local:AlbumRepositoryUserControl x:Class="MediaDeck.Views.Panes.RepositoryPanes.AlbumRepository"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Panes.RepositoryPanes"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:objects="using:MediaDeck.Core.Models.Repositories.Objects"
	mc:Ignorable="d" >

	<Grid x:Name="RootGrid"
		Background="Transparent"
		ContextRequested="AlbumArea_ContextRequested" >
		<Grid.Resources>
			<MenuFlyout x:Key="EmptyAreaContextMenu" >
				<MenuFlyoutItem x:Uid="AlbumRepository_ContextCreateAlbum"
					Click="CreateAlbum_Click" >
					<MenuFlyoutItem.Icon>
						<FontIcon Glyph="&#xE710;" />
					</MenuFlyoutItem.Icon>
				</MenuFlyoutItem>
			</MenuFlyout>
		</Grid.Resources>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<CheckBox Grid.Row="0"
			x:Uid="AlbumRepository_IncludeSubAlbums"
			Visibility="{x:Bind ViewModel.IsEmpty.Value, Mode=OneWay, Converter={StaticResource InvertBoolToVisibilityConverter}}"
			IsChecked="{x:Bind ViewModel.IncludeSubAlbums.Value,Mode=TwoWay}" />
		<TreeView Grid.Row="1"
			Visibility="{x:Bind ViewModel.IsEmpty.Value, Mode=OneWay, Converter={StaticResource InvertBoolToVisibilityConverter}}"
			ItemsSource="{x:Bind ViewModel.RootAlbum.Value.ChildAlbums, Mode=OneWay}"
			SelectedItem="{x:Bind ViewModel.SelectedAlbum.Value,Mode=TwoWay}" >
			<TreeView.ItemTemplate>
				<DataTemplate x:DataType="objects:AlbumObject" >
					<TreeViewItem AutomationProperties.Name="{x:Bind AlbumName}"
						ItemsSource="{x:Bind ChildAlbums}"
						DoubleTapped="TreeViewItem_DoubleTapped"
						IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" >
						<TreeViewItem.ContextFlyout>
							<MenuFlyout>
								<MenuFlyoutItem x:Uid="AlbumRepository_ContextRenameAlbum"
									Tag="{x:Bind}"
									Click="RenameAlbumMenuItem_Click" >
									<MenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE8AC;" />
									</MenuFlyoutItem.Icon>
								</MenuFlyoutItem>
								<MenuFlyoutItem x:Uid="AlbumRepository_ContextDeleteAlbum"
									Tag="{x:Bind}"
									Click="DeleteAlbumMenuItem_Click"
									IsEnabled="{x:Bind CanDelete}" >
									<MenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE74D;" />
									</MenuFlyoutItem.Icon>
								</MenuFlyoutItem>
							</MenuFlyout>
						</TreeViewItem.ContextFlyout>
						<StackPanel Orientation="Horizontal" >
							<FontIcon Glyph="&#xE8FD;" />
							<TextBlock Margin="0,0,10,0" />
							<TextBlock>
								<Run Text="{x:Bind AlbumName}" />
								<Run Text=" (" />
								<Run Text="{x:Bind FileCount}" />
								<Run Text=")" />
							</TextBlock>
						</StackPanel>
					</TreeViewItem>
				</DataTemplate>
			</TreeView.ItemTemplate>
		</TreeView>
		<ScrollViewer Grid.Row="0"
			Grid.RowSpan="2"
			VerticalScrollBarVisibility="Auto"
			HorizontalScrollBarVisibility="Disabled"
			VerticalContentAlignment="Center"
			Visibility="{x:Bind ViewModel.IsEmpty.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" >
			<StackPanel Spacing="8"
				Padding="8"
				HorizontalAlignment="Center"
				VerticalAlignment="Center" >
				<FontIcon Glyph="&#xE8FD;"
					FontSize="28"
					HorizontalAlignment="Center" />
				<TextBlock x:Uid="AlbumRepository_EmptyTitle"
					FontWeight="SemiBold"
					TextWrapping="Wrap"
					TextAlignment="Center"
					HorizontalAlignment="Center" />
				<TextBlock x:Uid="AlbumRepository_EmptyDescription"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					TextWrapping="Wrap"
					TextAlignment="Center"
					HorizontalAlignment="Center" />
				<Button Style="{StaticResource AccentButtonStyle}"
					HorizontalAlignment="Center"
					Margin="0,4,0,0"
					Click="CreateAlbum_Click" >
					<StackPanel Orientation="Horizontal"
						Spacing="6" >
						<FontIcon Glyph="&#xE710;"
							FontSize="14" />
						<TextBlock x:Uid="AlbumRepository_CreateAlbum" />
					</StackPanel>
				</Button>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</local:AlbumRepositoryUserControl>

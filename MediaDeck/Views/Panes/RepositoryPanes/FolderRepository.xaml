<?xml version="1.0" encoding="utf-8" ?>
<local:FolderRepositoryUserControl x:Class="MediaDeck.Views.Panes.RepositoryPanes.FolderRepository"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Panes.RepositoryPanes"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:objects="using:MediaDeck.Core.Models.Repositories.Objects"
	mc:Ignorable="d" >

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<CheckBox Grid.Row="0"
			x:Uid="FolderRepository_IncludeSubDirectories"
			IsChecked="{x:Bind ViewModel.IncludeSubDirectories.Value,Mode=TwoWay}"
			Visibility="{x:Bind ViewModel.IsEmpty.Value, Mode=OneWay, Converter={StaticResource InvertBoolToVisibilityConverter}}" />
		<TreeView Grid.Row="1"
			ItemsSource="{x:Bind ViewModel.RootFolder.Value.ChildFolders, Mode=OneWay}"
			SelectedItem="{x:Bind ViewModel.SelectedFolder.Value,Mode=TwoWay}"
			Visibility="{x:Bind ViewModel.IsEmpty.Value, Mode=OneWay, Converter={StaticResource InvertBoolToVisibilityConverter}}" >
			<TreeView.ItemTemplate>
				<DataTemplate x:DataType="objects:FolderObject" >
					<TreeViewItem AutomationProperties.Name="{x:Bind FolderName}"
						ItemsSource="{x:Bind ChildFolders}"
						DoubleTapped="TreeViewItem_DoubleTapped"
						IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" >
						<StackPanel Orientation="Horizontal" >
							<FontIcon Glyph="&#xE838;" />
							<TextBlock Margin="0,0,10,0" />
							<TextBlock>
								<Run Text="{x:Bind FolderName}" />
								<Run Text=" (" />
								<Run Text="{x:Bind FileCount}" />
								<Run Text=")" />
							</TextBlock>
						</StackPanel>
					</TreeViewItem>
				</DataTemplate>
			</TreeView.ItemTemplate>
		</TreeView>

		<!-- 空状態の誘導表示 -->
		<ScrollViewer Grid.Row="0"
			Grid.RowSpan="2"
			VerticalScrollBarVisibility="Auto"
			HorizontalScrollBarVisibility="Disabled"
			VerticalContentAlignment="Center"
			Visibility="{x:Bind ViewModel.IsEmpty.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" >
			<StackPanel HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Spacing="8"
				Padding="8" >
				<FontIcon Glyph="&#xE8B7;"
					FontSize="28"
					Foreground="{ThemeResource TextFillColorTertiaryBrush}"
					HorizontalAlignment="Center" />

				<!-- フォルダ未登録時 -->
				<StackPanel Spacing="4"
					Visibility="{x:Bind ViewModel.ShowNoRegisteredFoldersGuide.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" >
					<TextBlock x:Uid="FolderRepository_EmptyNoFoldersTitle"
						HorizontalAlignment="Center"
						TextAlignment="Center"
						TextWrapping="Wrap"
						Style="{ThemeResource BodyStrongTextBlockStyle}"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
					<TextBlock x:Uid="FolderRepository_EmptyNoFoldersDescription"
						HorizontalAlignment="Center"
						TextAlignment="Center"
						TextWrapping="Wrap"
						Style="{ThemeResource CaptionTextBlockStyle}"
						Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
				</StackPanel>

				<!-- フォルダ登録済み・メディア未登録時 -->
				<StackPanel Spacing="4"
					Visibility="{x:Bind ViewModel.ShowNoMediaItemsGuide.Value, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" >
					<TextBlock x:Uid="FolderRepository_EmptyNoMediaTitle"
						HorizontalAlignment="Center"
						TextAlignment="Center"
						TextWrapping="Wrap"
						Style="{ThemeResource BodyStrongTextBlockStyle}"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
					<TextBlock x:Uid="FolderRepository_EmptyNoMediaDescription"
						HorizontalAlignment="Center"
						TextAlignment="Center"
						TextWrapping="Wrap"
						Style="{ThemeResource CaptionTextBlockStyle}"
						Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
				</StackPanel>

				<Button x:Name="OpenFolderManagerButton"
					Click="OpenFolderManagerButton_Click"
					Style="{StaticResource AccentButtonStyle}"
					HorizontalAlignment="Center"
					Margin="0,4,0,0" >
					<StackPanel Orientation="Horizontal"
						Spacing="6" >
						<FontIcon Glyph="&#xED41;"
							FontSize="14" />
						<TextBlock x:Uid="FolderRepository_OpenFolderManager" />
					</StackPanel>
				</Button>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</local:FolderRepositoryUserControl>
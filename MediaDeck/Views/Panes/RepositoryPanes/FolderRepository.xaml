<?xml version="1.0" encoding="utf-8" ?>
<local:FolderRepositoryUserControl x:Class="MediaDeck.Views.Panes.RepositoryPanes.FolderRepository"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Panes.RepositoryPanes"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:objects="using:MediaDeck.Core.Models.Repositories.Objects"
	mc:Ignorable="d" >

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<CheckBox Grid.Row="0"
			x:Uid="FolderRepository_IncludeSubDirectories"
			IsChecked="{x:Bind ViewModel.IncludeSubDirectories.Value,Mode=TwoWay}" />
		<TreeView Grid.Row="1"
			ItemsSource="{x:Bind ViewModel.RootFolder.Value.ChildFolders, Mode=OneWay}"
			SelectedItem="{x:Bind ViewModel.SelectedFolder.Value,Mode=TwoWay}" >
			<TreeView.ItemTemplate>
				<DataTemplate x:DataType="objects:FolderObject" >
					<TreeViewItem AutomationProperties.Name="{x:Bind FolderName}"
						ItemsSource="{x:Bind ChildFolders}"
						DoubleTapped="TreeViewItem_DoubleTapped"
						IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" >
						<StackPanel Orientation="Horizontal" >
							<FontIcon Glyph="&#xE838;" />
							<TextBlock Margin="0,0,10,0" />
							<TextBlock>
								<Run Text="{x:Bind FolderName}" />
								<Run Text=" (" />
								<Run Text="{x:Bind FileCount}" />
								<Run Text=")" />
							</TextBlock>
						</StackPanel>
					</TreeViewItem>
				</DataTemplate>
			</TreeView.ItemTemplate>
		</TreeView>
	</Grid>
</local:FolderRepositoryUserControl>
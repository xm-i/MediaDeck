<?xml version="1.0" encoding="utf-8" ?>
<local:TabContentPaneUserControl x:Class="MediaDeck.Views.Panes.TabPanes.TabContentPane"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.Views.Panes.TabPanes"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:viewerPanes="using:MediaDeck.Views.Panes.ViewerPanes"
	xmlns:filterPanes="using:MediaDeck.Views.Panes.FilterPanes"
	xmlns:sortPanes="using:MediaDeck.Views.Panes.SortPanes"
	xmlns:detailPanes="using:MediaDeck.Views.Panes.DetailPanes"
	xmlns:repositoryPanes="using:MediaDeck.Views.Panes.RepositoryPanes"
	xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
	mc:Ignorable="d" >

	<Grid Padding="2">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="{x:Bind ViewModel.LeftPaneWidth.Value, Mode=TwoWay, Converter={StaticResource DoubleToGridLengthConverter}}" MinWidth="100" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="{x:Bind ViewModel.RightPaneWidth.Value, Mode=TwoWay, Converter={StaticResource DoubleToGridLengthConverter}}" MinWidth="100" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="{x:Bind ViewModel.RepositoryPaneHeight.Value, Mode=TwoWay, Converter={StaticResource DoubleToGridLengthConverter}}" MinHeight="100" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<repositoryPanes:RepositorySelector Grid.Column="0" Grid.Row="0"
			ViewModel="{x:Bind ViewModel.RepositorySelectorViewModel, Mode=OneWay}" />
		<toolkit:GridSplitter Grid.Column="0" Grid.Row="1"
			Height="4"
			ResizeDirection="Rows"
			ResizeBehavior="BasedOnAlignment"
			HorizontalAlignment="Stretch" />
		<Grid Grid.Column="0" Grid.Row="2">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<sortPanes:SortPane Grid.Row="0"
				ViewModel="{x:Bind ViewModel.SortSelectorViewModel, Mode=OneWay}" />
			<filterPanes:FilterSelector Grid.Row="1"
				ViewModel="{x:Bind ViewModel.FilterSelectorViewModel, Mode=OneWay}" />
		</Grid>
		<toolkit:GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
			Width="4"
			ResizeBehavior="BasedOnAlignment" />
		<viewerPanes:ViewerSelector Grid.Column="2" Grid.Row="0" Grid.RowSpan="3"
			ViewModel="{x:Bind ViewModel.ViewerSelectorViewModel, Mode=OneWay}" />
		<toolkit:GridSplitter Grid.Column="3" Grid.Row="0" Grid.RowSpan="3"
			Width="4"
			ResizeBehavior="BasedOnAlignment" />
		<detailPanes:DetailSelector Grid.Column="4" Grid.Row="0" Grid.RowSpan="3"
			ViewModel="{x:Bind ViewModel.DetailSelectorViewModel, Mode=OneWay}" />
	</Grid>
</local:TabContentPaneUserControl>

<?xml version="1.0" encoding="utf-8" ?>
<local:VideoBulkThumbnailConfigViewUserControl
	x:Class="MediaDeck.MediaItemTypes.UI.Video.Views.VideoBulkThumbnailConfigView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.MediaItemTypes.UI.Video.Views"
	xmlns:vm="using:MediaDeck.MediaItemTypes.Video.ViewModels"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" >
	<StackPanel Padding="12" Spacing="12" >
		<TextBlock x:Uid="VideoBulkThumbnailConfig_Title" FontWeight="SemiBold" />
		<TextBlock x:Uid="VideoBulkThumbnailConfig_Description" TextWrapping="Wrap" />
		<ComboBox x:Uid="VideoBulkThumbnailConfig_Mode"
			SelectedIndex="{x:Bind ModeIndex, Mode=TwoWay}" >
			<ComboBoxItem x:Uid="VideoBulkThumbnailConfig_ModeSeconds" />
			<ComboBoxItem x:Uid="VideoBulkThumbnailConfig_ModePercentage" />
		</ComboBox>
		<NumberBox x:Uid="VideoBulkThumbnailConfig_Seconds"
			Minimum="0" SpinButtonPlacementMode="Inline"
			Visibility="{x:Bind SecondsVisibility, Mode=OneWay}"
			Value="{x:Bind ViewModel.Seconds.Value, Mode=TwoWay}" />
		<NumberBox x:Uid="VideoBulkThumbnailConfig_Percentage"
			Minimum="0" Maximum="100" SpinButtonPlacementMode="Inline"
			Visibility="{x:Bind PercentageVisibility, Mode=OneWay}"
			Value="{x:Bind ViewModel.Percentage.Value, Mode=TwoWay}" />
	</StackPanel>
</local:VideoBulkThumbnailConfigViewUserControl>

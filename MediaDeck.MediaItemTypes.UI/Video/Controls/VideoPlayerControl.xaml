<?xml version="1.0" encoding="utf-8" ?>
<UserControl
	x:Class="MediaDeck.MediaItemTypes.UI.Video.Controls.VideoPlayerControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:MediaDeck.MediaItemTypes.UI.Video.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:flyleaf="using:FlyleafLib.Controls.WinUI"
	mc:Ignorable="d">
	<UserControl.Resources>
		<flyleaf:TicksToTimeConverter x:Key="TicksToTime" />
		<flyleaf:TicksToSecondsConverter x:Key="TicksToSeconds" />
	</UserControl.Resources>
	<Grid x:Name="rootGrid">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<flyleaf:FlyleafHost x:Name="flyleafHost" Player="{x:Bind Player, Mode=OneWay}" />
		<Image x:Name="imgThumbnail"
			Source="{x:Bind ThumbnailSource, Mode=OneWay}"
			Stretch="Uniform"
			Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}" />
		<Grid Grid.Row="1" VerticalAlignment="Bottom" Background="#1000">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>

			<Grid Grid.Row="1" Margin="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Orientation="Horizontal">
					<Button x:Name="btnPlayback" IsTabStop="False" Command="{x:Bind Player.Commands.TogglePlayPause, Mode=OneWay}" IsEnabled="{x:Bind Player.CanPlay, Mode=OneWay}" />
				</StackPanel>

				<Grid Margin="8,0,8,0" Grid.Column="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Slider IsTabStop="False" Grid.Column="0" Margin="10,0,10,0"
						VerticalAlignment="Center"
						IsThumbToolTipEnabled="False"
						Value="{Binding Player.CurTime, Mode=TwoWay, Converter={StaticResource TicksToSeconds}}"
						Maximum="{x:Bind Player.Duration, Mode=OneWay, Converter={StaticResource TicksToSeconds}}" />

					<TextBlock Grid.Column="1"
						HorizontalAlignment="Left"
						VerticalAlignment="Center">
						<Run Text="{x:Bind Player.CurTime, Mode=OneWay, Converter={StaticResource TicksToTime}}" />
						<Run Text=" / " />
						<Run Text="{x:Bind Player.Duration, Mode=OneWay, Converter={StaticResource TicksToTime}}" />
					</TextBlock>
				</Grid>

				<StackPanel Grid.Column="2" Orientation="Horizontal">
					<Slider IsTabStop="False" Maximum="100" Value="{x:Bind Player.Audio.Volume, Mode=TwoWay}" Width="100" />
				</StackPanel>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
